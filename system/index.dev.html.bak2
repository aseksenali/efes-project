<!doctype html>
<!-- Efes Nexus — EDITABLE SOURCE. Loads React/Babel/TanStack from CDN (needs internet). Edit here, then re-inline to regenerate the self-contained index.html. -->
<html lang="ru">
<head>
<meta charset="utf-8"/>
<title>Efes — Менеджер промо-активностей</title>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
/* Efes Nexus — Efes
   Stripe/Mercury-style enterprise palette anchored on #004c8d */

:root {
  --brand-900: #002a52;
  --brand-800: #003a73;
  --brand-700: #004c8d;
  --brand-600: #1166a8;
  --brand-500: #2d83c4;
  --brand-100: #e6eff7;
  --brand-50:  #f3f7fb;

  --bg: #f7f8fa;
  --surface: #ffffff;
  --surface-2: #fbfcfd;
  --border: #e6e8ec;
  --border-strong: #d6d9df;
  --text: #15181c;
  --text-2: #4a5160;
  --text-3: #7a8294;
  --text-muted: #9aa1ad;

  --ok-bg: #e9f7ee;
  --ok-fg: #0a7a3b;
  --ok-border: #b9e3c8;

  --warn-bg: #fdf3e0;
  --warn-fg: #8a5a06;
  --warn-border: #f0d9a3;

  --bad-bg: #fdeaea;
  --bad-fg: #a51e1e;
  --bad-border: #f1c2c2;

  --neutral-bg: #f0f1f3;
  --neutral-fg: #4a5160;
  --neutral-border: #dfe2e7;

  --info-bg: #e8f1fa;
  --info-fg: #0e4f8a;

  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04), 0 1px 1px rgba(15, 23, 42, 0.03);
  --shadow-md: 0 6px 16px rgba(15, 23, 42, 0.06), 0 2px 4px rgba(15, 23, 42, 0.04);
  --shadow-lg: 0 18px 48px rgba(15, 23, 42, 0.10), 0 6px 16px rgba(15, 23, 42, 0.06);

  --radius-sm: 6px;
  --radius: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;

  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
}

[data-theme='dark'] {
  --bg: #0c1117;
  --surface: #141a22;
  --surface-2: #1a212b;
  --border: #232b37;
  --border-strong: #2e3743;
  --text: #ecf0f5;
  --text-2: #b8c0cc;
  --text-3: #8a93a3;
  --text-muted: #6c7586;

  --brand-100: #0e2a47;
  --brand-50:  #0a1d31;

  --ok-bg: #0f2c1d;
  --ok-fg: #4cc480;
  --ok-border: #1d4a32;

  --warn-bg: #2d2210;
  --warn-fg: #e7b563;
  --warn-border: #4a3a1c;

  --bad-bg: #2c1414;
  --bad-fg: #ef7878;
  --bad-border: #4a2222;

  --neutral-bg: #1d242e;
  --neutral-fg: #b8c0cc;
  --neutral-border: #2c3441;

  --info-bg: #0e2a47;
  --info-fg: #6db0ec;

  --shadow-sm: 0 1px 2px rgba(0,0,0,.4);
  --shadow-md: 0 6px 16px rgba(0,0,0,.4);
  --shadow-lg: 0 18px 48px rgba(0,0,0,.55);
}

* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  font-family: var(--font-sans);
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
body { min-height: 100vh; }
button { font-family: inherit; cursor: pointer; }
input, textarea, select { font-family: inherit; color: inherit; }

/* ===== App shell ===== */
.app {
  display: grid;
  grid-template-columns: 248px 1fr;
  min-height: 100vh;
}

.sidebar {
  background: var(--surface);
  border-right: 1px solid var(--border);
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
}
.brand {
  display: flex; align-items: center; gap: 10px;
  padding: 6px 8px 18px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 12px;
}
.brand-mark {
  width: 32px; height: 32px;
  border-radius: 8px;
  background: linear-gradient(140deg, var(--brand-700), var(--brand-500));
  display: grid; place-items: center;
  color: #fff; font-weight: 700; font-size: 14px;
  letter-spacing: 0.02em;
  box-shadow: var(--shadow-sm);
}
.brand-text { display: flex; flex-direction: column; line-height: 1.15; }
.brand-text strong { font-size: 13px; color: var(--text); }
.brand-text span { font-size: 11px; color: var(--text-3); }

.nav-section-label {
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-3); padding: 14px 10px 6px;
}
.nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 10px;
  border-radius: 8px;
  color: var(--text-2);
  font-size: 13px; font-weight: 500;
  cursor: pointer;
  border: 1px solid transparent;
}
.nav-item:hover { background: var(--brand-50); color: var(--text); }
.nav-item.active {
  background: var(--brand-100);
  color: var(--brand-700);
  border-color: color-mix(in oklab, var(--brand-700) 18%, transparent);
}
[data-theme='dark'] .nav-item.active { color: #6db0ec; }
.nav-item .nav-count {
  margin-left: auto;
  font-size: 11px;
  background: var(--neutral-bg);
  color: var(--text-2);
  padding: 1px 7px;
  border-radius: 999px;
  font-weight: 600;
}
.nav-item.active .nav-count {
  background: color-mix(in oklab, var(--brand-700) 18%, transparent);
  color: var(--brand-700);
}

.user-card {
  margin-top: auto;
  display: flex; align-items: center; gap: 10px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-2);
}
.user-avatar {
  width: 32px; height: 32px;
  border-radius: 50%;
  background: linear-gradient(140deg, #6e8cb1, #305d8e);
  color: #fff;
  display: grid; place-items: center;
  font-size: 12px; font-weight: 600;
}
.user-meta { line-height: 1.2; min-width: 0; }
.user-meta strong { font-size: 12.5px; display: block; }
.user-meta span { font-size: 11px; color: var(--text-3); }

/* ===== Main ===== */
.main { display: flex; flex-direction: column; min-width: 0; }
.topbar {
  height: 60px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center;
  padding: 0 28px; gap: 14px;
  position: sticky; top: 0; z-index: 20;
}
.topbar .crumbs { font-size: 13px; color: var(--text-3); }
.topbar .crumbs strong { color: var(--text); font-weight: 600; }
.topbar .search {
  flex: 1; max-width: 480px;
  display: flex; align-items: center; gap: 8px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 7px 10px;
  margin-left: 24px;
}
.topbar .search input {
  border: none; background: transparent; outline: none;
  flex: 1; font-size: 13px;
}
.topbar .search-icon { color: var(--text-3); flex: none; }
.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }

/* ===== Components ===== */
.lang-toggle {
  display: inline-flex;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 2px;
}
.lang-toggle button {
  border: none; background: transparent; padding: 5px 10px;
  font-size: 12px; font-weight: 600; color: var(--text-3);
  border-radius: 6px;
}
.lang-toggle button.active {
  background: var(--surface); color: var(--text); box-shadow: var(--shadow-sm);
}

.btn {
  display: inline-flex; align-items: center; gap: 7px;
  border: 1px solid var(--border-strong);
  background: var(--surface);
  color: var(--text);
  padding: 7px 12px;
  border-radius: 8px;
  font-size: 13px; font-weight: 500;
  transition: background .12s ease, border-color .12s ease, transform .05s ease;
}
.btn:hover { background: var(--surface-2); }
.btn:active { transform: translateY(1px); }
.btn.primary {
  background: var(--brand-700);
  border-color: var(--brand-700);
  color: #fff;
  box-shadow: var(--shadow-sm);
}
.btn.primary:hover { background: var(--brand-800); border-color: var(--brand-800); }
.btn.ghost { border-color: transparent; background: transparent; }
.btn.ghost:hover { background: var(--brand-50); }
.btn.danger { color: var(--bad-fg); border-color: var(--bad-border); background: var(--bad-bg); }
.btn.danger:hover { background: color-mix(in oklab, var(--bad-bg) 80%, var(--bad-fg) 6%); }
.btn.sm { padding: 5px 9px; font-size: 12px; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }

.badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11.5px; font-weight: 600;
  padding: 3px 8px;
  border-radius: 999px;
  border: 1px solid var(--neutral-border);
  background: var(--neutral-bg);
  color: var(--neutral-fg);
  letter-spacing: 0.01em;
}
.badge.dot::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: currentColor;
}
.badge.ok    { background: var(--ok-bg);    color: var(--ok-fg);    border-color: var(--ok-border); }
.badge.warn  { background: var(--warn-bg);  color: var(--warn-fg);  border-color: var(--warn-border); }
.badge.bad   { background: var(--bad-bg);   color: var(--bad-fg);   border-color: var(--bad-border); }
.badge.info  { background: var(--info-bg);  color: var(--info-fg);  border-color: color-mix(in oklab, var(--info-fg) 25%, transparent); }
.badge.draft { background: var(--neutral-bg); color: var(--text-3); }

.badge-type {
  font-family: var(--font-mono);
  font-size: 11px;
  background: var(--brand-50);
  border-color: color-mix(in oklab, var(--brand-700) 20%, transparent);
  color: var(--brand-700);
}
[data-theme='dark'] .badge-type { color: #6db0ec; }

.code-tag {
  font-family: var(--font-mono);
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text);
  background: var(--surface-2);
  border: 1px solid var(--border);
  padding: 2px 7px;
  border-radius: 6px;
  letter-spacing: 0.02em;
}

.kbd {
  font-family: var(--font-mono);
  font-size: 11px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  padding: 1px 5px;
  border-radius: 4px;
  color: var(--text-3);
}

/* ===== Page ===== */
.page { padding: 24px 28px 60px; max-width: 1500px; }
.page-title {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18px; flex-wrap: wrap; gap: 14px;
}
.page-title h1 {
  font-size: 22px; font-weight: 600; margin: 0; letter-spacing: -0.01em;
}
.page-title p { margin: 2px 0 0; color: var(--text-3); font-size: 13px; }
.page-actions { display: flex; gap: 8px; align-items: center; }

/* ===== Stat tiles ===== */
.stats {
  display: grid; gap: 12px;
  grid-template-columns: repeat(4, 1fr);
  margin-bottom: 18px;
}
.stat {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 16px 18px;
  display: flex; flex-direction: column; gap: 4px;
  position: relative;
  overflow: hidden;
}
.stat .stat-label { font-size: 12px; color: var(--text-3); font-weight: 500; }
.stat .stat-value {
  font-size: 26px; font-weight: 600; letter-spacing: -0.02em;
  font-feature-settings: 'tnum';
}
.stat .stat-sub { font-size: 12px; color: var(--text-3); margin-top: 4px; }
.stat .stat-sub b { color: var(--ok-fg); font-weight: 600; }
.stat::after {
  content: ''; position: absolute; right: -40px; bottom: -40px;
  width: 130px; height: 130px; border-radius: 50%;
  background: radial-gradient(closest-side, color-mix(in oklab, var(--brand-700) 7%, transparent), transparent 70%);
}

/* ===== Filters / table ===== */
.toolbar {
  display: flex; align-items: center; gap: 8px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 10px 14px;
  border-bottom: none;
  flex-wrap: wrap;
}
.chip {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 12px; padding: 5px 10px;
  border: 1px solid var(--border-strong);
  background: var(--surface);
  border-radius: 999px;
  color: var(--text-2);
  font-weight: 500;
}
.chip:hover { background: var(--surface-2); }
.chip.active {
  background: var(--brand-100);
  color: var(--brand-700);
  border-color: color-mix(in oklab, var(--brand-700) 25%, transparent);
}
[data-theme='dark'] .chip.active { color: #6db0ec; }
.chip .x { color: var(--text-3); margin-left: 4px; }

.toolbar-spacer { flex: 1; }

.table-wrap {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  overflow: hidden;
}
table.data {
  width: 100%; border-collapse: collapse; font-size: 13px;
}
table.data thead th {
  text-align: left; font-weight: 600; font-size: 11.5px;
  color: var(--text-3); text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  background: var(--surface-2);
  white-space: nowrap;
}
table.data tbody td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
}
table.data tbody tr:last-child td { border-bottom: none; }
table.data tbody tr { transition: background .08s ease; }
table.data tbody tr:hover { background: var(--brand-50); cursor: pointer; }
table.data tbody tr.selected { background: var(--brand-50); }

.cell-stack { display: flex; flex-direction: column; line-height: 1.25; }
.cell-stack .sub { color: var(--text-3); font-size: 12px; }
.cell-num { font-family: var(--font-mono); font-feature-settings: 'tnum'; }

/* progress bar */
.progress {
  height: 6px; background: var(--neutral-bg); border-radius: 999px; overflow: hidden;
  width: 120px;
}
.progress > span {
  display: block; height: 100%;
  background: linear-gradient(90deg, var(--brand-600), var(--brand-500));
  border-radius: 999px;
}
.progress.warn > span { background: linear-gradient(90deg, #d18316, #e7a849); }
.progress.bad > span  { background: linear-gradient(90deg, #b03030, #d05858); }

/* ===== Drawer ===== */
.drawer-mask {
  position: fixed; inset: 0; background: rgba(15,23,42,.32);
  backdrop-filter: blur(2px);
  z-index: 80;
}
.drawer {
  position: fixed; top: 0; right: 0; height: 100vh;
  width: min(720px, 92vw);
  background: var(--surface);
  border-left: 1px solid var(--border);
  z-index: 90;
  display: flex; flex-direction: column;
  box-shadow: var(--shadow-lg);
  animation: slideIn .22s ease;
}
.drawer.wide { width: min(900px, 95vw); }
@keyframes slideIn { from { transform: translateX(20px); opacity: 0; } to { transform: none; opacity: 1; } }
.drawer-head {
  padding: 18px 22px;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 12px;
}
.drawer-head h2 { margin: 0; font-size: 16px; font-weight: 600; }
.drawer-head .sub { color: var(--text-3); font-size: 12px; }
.drawer-body { flex: 1; overflow-y: auto; padding: 22px; }
.drawer-foot {
  border-top: 1px solid var(--border);
  padding: 12px 22px;
  display: flex; align-items: center; gap: 10px;
  background: var(--surface-2);
}
.icon-btn {
  width: 30px; height: 30px; display: grid; place-items: center;
  border: 1px solid var(--border); border-radius: 8px;
  background: var(--surface); color: var(--text-2);
}
.icon-btn:hover { background: var(--surface-2); color: var(--text); }

/* ===== Detail layout ===== */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 22px;
}
.section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  margin-bottom: 16px;
}
.section h3 {
  font-size: 13px; font-weight: 600; margin: 0 0 12px;
  color: var(--text-2);
  text-transform: uppercase; letter-spacing: 0.05em;
}
.kv-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px;
}
.kv { display: flex; flex-direction: column; gap: 2px; }
.kv .k { font-size: 11.5px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.04em; }
.kv .v { font-size: 14px; color: var(--text); font-weight: 500; }
.kv.editable .v { display: flex; align-items: center; gap: 6px; }
.kv.editable .edit-btn {
  opacity: 0; transition: opacity .12s;
  border: none; background: transparent; color: var(--text-3); padding: 2px;
}
.kv.editable:hover .edit-btn { opacity: 1; }

.ops-list { display: grid; gap: 8px; grid-template-columns: 1fr; }
.op-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-2);
}
.op-row:hover { background: var(--brand-50); }
.op-row strong { font-size: 13px; font-weight: 600; }
.op-row .desc { font-size: 12px; color: var(--text-3); }

.timeline { display: flex; flex-direction: column; gap: 10px; }
.tl-item {
  display: grid; grid-template-columns: 14px 1fr; gap: 10px; font-size: 12.5px;
  position: relative;
}
.tl-item::before {
  content: ''; width: 8px; height: 8px; border-radius: 50%;
  background: var(--brand-500);
  margin-top: 6px; margin-left: 3px;
}
.tl-item .when { color: var(--text-3); font-size: 11.5px; }

/* ===== Tree picker ===== */
.tree { font-size: 13px; }
.tree-node {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 6px;
}
.tree-node:hover { background: var(--brand-50); }
.tree-node .twisty {
  width: 16px; height: 16px; display: grid; place-items: center;
  color: var(--text-3); cursor: pointer;
}
.tree-node label { display: flex; align-items: center; gap: 8px; cursor: pointer; flex: 1; }
.tree-node .count { font-size: 11px; color: var(--text-3); }
.tree-children { padding-left: 22px; border-left: 1px dashed var(--border); margin-left: 11px; }

/* ===== Wizard ===== */
.steps {
  display: flex; gap: 0;
  border-bottom: 1px solid var(--border);
  padding: 0 22px;
}
.step {
  display: flex; align-items: center; gap: 10px;
  padding: 14px 0;
  margin-right: 28px;
  font-size: 13px; color: var(--text-3); font-weight: 500;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
}
.step .num {
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--neutral-bg); color: var(--text-3);
  display: grid; place-items: center; font-size: 11px; font-weight: 700;
}
.step.active { color: var(--brand-700); border-bottom-color: var(--brand-700); }
.step.active .num { background: var(--brand-700); color: #fff; }
.step.done .num { background: var(--ok-fg); color: #fff; }
.step.done { color: var(--text-2); }

/* ===== Form bits ===== */
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.field label { font-size: 12px; font-weight: 500; color: var(--text-2); }
.field .hint { font-size: 11.5px; color: var(--text-3); }
.input, .textarea, .select {
  border: 1px solid var(--border-strong);
  background: var(--surface);
  color: var(--text);
  padding: 8px 10px;
  border-radius: 8px;
  font-size: 13px;
  outline: none;
  transition: border-color .12s, box-shadow .12s;
}
.input:focus, .textarea:focus, .select:focus {
  border-color: var(--brand-500);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand-700) 14%, transparent);
}
.textarea { min-height: 100px; resize: vertical; font-family: var(--font-sans); }
.row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

.type-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.type-card {
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 12px;
  padding: 16px;
  cursor: pointer;
  display: flex; flex-direction: column; gap: 8px;
}
.type-card:hover { border-color: var(--brand-500); }
.type-card.selected {
  border-color: var(--brand-700);
  background: var(--brand-50);
  box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand-700) 14%, transparent);
}
.type-card.disabled { opacity: 0.45; cursor: not-allowed; }
.type-card .t-title { font-size: 14px; font-weight: 600; }
.type-card .t-desc { font-size: 12px; color: var(--text-3); }

/* AI panel */
.ai-card {
  border-radius: 12px;
  border: 1px solid var(--border);
  padding: 14px 16px;
  background: linear-gradient(160deg, var(--brand-50), var(--surface));
}
[data-theme='dark'] .ai-card { background: var(--surface-2); }
.ai-card .ai-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.ai-card .ai-head strong { font-size: 13px; }
.ai-card .conf {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11.5px; color: var(--text-3); margin-left: auto;
  font-family: var(--font-mono);
}
.ai-card .conf-bar {
  width: 60px; height: 4px; background: var(--neutral-bg); border-radius: 2px; overflow: hidden;
}
.ai-card .conf-bar > span { display: block; height: 100%; background: var(--brand-600); }
.ai-card .ai-notes { font-size: 12.5px; color: var(--text-2); line-height: 1.55; }

/* Email preview */
.email {
  border: 1px solid var(--border);
  background: var(--surface-2);
  border-radius: 12px;
  overflow: hidden;
}
.email-head {
  display: grid; grid-template-columns: 80px 1fr; gap: 4px 12px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  background: var(--surface);
  font-size: 12.5px;
}
.email-head .lk { color: var(--text-3); }
.email-head .vl { color: var(--text); }
.email-body { padding: 16px; font-size: 13px; white-space: pre-wrap; line-height: 1.55; }

/* product chip */
.prod-chip {
  display: inline-flex; align-items: center; gap: 6px;
  border: 1px solid var(--border); background: var(--surface-2);
  padding: 4px 8px; border-radius: 7px; font-size: 12px;
  font-family: var(--font-mono);
}
.prod-chip .rm { color: var(--text-3); cursor: pointer; }

/* selectable rows */
.checkbox {
  width: 16px; height: 16px; border-radius: 4px;
  border: 1.5px solid var(--border-strong);
  background: var(--surface); cursor: pointer;
  display: grid; place-items: center;
  flex: none;
}
.checkbox.checked { background: var(--brand-700); border-color: var(--brand-700); }
.checkbox.checked svg { color: #fff; }
.checkbox.indet { background: var(--brand-700); border-color: var(--brand-700); }
.checkbox.indet::after { content: ''; width: 8px; height: 2px; background: #fff; border-radius: 1px; }

/* small dot list */
.dot-list { display: flex; flex-wrap: wrap; gap: 6px; }

/* AI variations switcher */
.ai-evidence {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  font-size: 12.5px;
}
.ai-evidence .col {
  border: 1px solid var(--border); border-radius: 8px;
  padding: 10px 12px; background: var(--surface);
}
.ai-evidence .col h5 {
  margin: 0 0 6px; font-size: 11px; text-transform: uppercase;
  letter-spacing: 0.05em; color: var(--text-3); font-weight: 600;
}
.diff-row {
  display: flex; justify-content: space-between; padding: 4px 0;
  border-bottom: 1px dashed var(--border); font-family: var(--font-mono);
}
.diff-row:last-child { border-bottom: none; }
.diff-row .delta { font-weight: 600; }
.diff-row .delta.ok { color: var(--ok-fg); }
.diff-row .delta.bad { color: var(--bad-fg); }
.diff-row .delta.warn { color: var(--warn-fg); }

/* AI conversational */
.ai-chat { display: flex; flex-direction: column; gap: 10px; }
.ai-msg {
  display: flex; gap: 10px; align-items: flex-start;
  font-size: 12.5px;
}
.ai-msg .av {
  width: 26px; height: 26px; border-radius: 50%;
  background: linear-gradient(140deg, var(--brand-700), var(--brand-500));
  color: #fff; display: grid; place-items: center; font-size: 11px; font-weight: 700;
  flex: none;
}
.ai-msg .bubble {
  background: var(--surface); border: 1px solid var(--border);
  padding: 8px 12px; border-radius: 12px; line-height: 1.5;
}

/* Toast */
.toast-wrap {
  position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%);
  z-index: 999;
  display: flex; flex-direction: column; gap: 8px;
}
.toast {
  background: var(--text); color: var(--surface);
  padding: 10px 16px; border-radius: 10px;
  font-size: 13px; font-weight: 500;
  box-shadow: var(--shadow-lg);
  display: flex; align-items: center; gap: 8px;
  animation: toastIn .22s ease;
}
@keyframes toastIn { from { transform: translateY(8px); opacity: 0; } to { transform: none; opacity: 1; } }

/* misc */
.empty {
  padding: 36px; text-align: center; color: var(--text-3);
}
.divider { height: 1px; background: var(--border); margin: 14px 0; }

.scroll-hint::-webkit-scrollbar { width: 8px; height: 8px; }
.scroll-hint::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }

@media (max-width: 980px) {
  .app { grid-template-columns: 1fr; }
  .sidebar { position: relative; height: auto; }
  .stats { grid-template-columns: repeat(2, 1fr); }
  .detail-grid { grid-template-columns: 1fr; }
}

/* ===== Enhanced promo table (group / sort / filter) ===== */
.toolbar .tb-div { width: 1px; height: 22px; background: var(--border); flex: none; }
.toolbar .tb-label { font-size: 11.5px; color: var(--text-3); text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
.toolbar .tb-hint { font-size: 12px; color: var(--text-3); white-space: nowrap; }
.group-by { display: inline-flex; align-items: center; gap: 8px; }
.select.compact { padding: 5px 10px; font-size: 12px; border-radius: 8px; }
.toolbar.toolbar-sub { border-radius: 0; border-top: 1px solid var(--border); padding-top: 8px; padding-bottom: 8px; min-height: 43px; }

table.data thead th.sortable { cursor: pointer; user-select: none; transition: background .08s ease, color .08s ease; }
table.data thead th.sortable:hover { color: var(--text-2); background: var(--brand-50); }
.th-inner { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
.sort-ind { font-size: 9px; color: var(--text-muted); opacity: .55; }
.sort-ind.asc, .sort-ind.desc { color: var(--brand-600); opacity: 1; }

tr.group-row { cursor: pointer; }
tr.group-row td { background: var(--surface-2); padding: 9px 14px; }
tr.group-row:hover td { background: var(--brand-50); }
.group-head { display: flex; align-items: center; gap: 10px; }
.group-twisty { display: grid; place-items: center; color: var(--text-3); }
.group-dim { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--text-3); font-weight: 600; }
.group-val { font-size: 13px; font-weight: 600; color: var(--text); display: inline-flex; align-items: center; }
.group-aggs { margin-left: auto; display: flex; gap: 16px; font-size: 12px; color: var(--text-3); font-family: var(--font-mono); }
</style></head><body><div id="root"></div>
