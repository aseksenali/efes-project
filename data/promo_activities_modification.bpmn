      <bpmndi:BPMNShape id="Task_CRM_Notify_di" bpmnElement="Task_CRM_Notify">
        <dc:Bounds x="885" y="430" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_SSC_EmailMerge_di" bpmnElement="Gw_SSC_EmailMerge" isMarkerVisible="true">
        <dc:Bounds x="615" y="610" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_SSC_AndJoin_di" bpmnElement="Gw_SSC_AndJoin">
        <dc:Bounds x="1065" y="610" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SSC_Take_di" bpmnElement="Task_SSC_Take">
