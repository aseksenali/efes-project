function pad5(n) { return String(n).padStart(5, '0'); }
function daysAgo(d) { const x = new Date('2026-05-02T00:00:00'); x.setDate(x.getDate() - d); return x.toISOString().slice(0, 10); }
function daysAhead(d) { const x = new Date('2026-05-02T00:00:00'); x.setDate(x.getDate() + d); return x.toISOString().slice(0, 10); }

