<script type="text/babel" data-presets="react">

// tweaks-panel.jsx
// Reusable Tweaks shell + form-control helpers.
//
// Owns the host protocol (listens for __activate_edit_mode / __deactivate_edit_mode,
// posts __edit_mode_available / __edit_mode_set_keys / __edit_mode_dismissed) so
// individual prototypes don't re-roll it. Ships a consistent set of controls so you
// don't hand-draw <input type="range">, segmented radios, steppers, etc.
//
// Usage (in an HTML file that loads React + Babel):
//
//   const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
//     "primaryColor": "#D97757",
//     "fontSize": 16,
//     "density": "regular",
//     "dark": false
//   }/*EDITMODE-END*/;
//
//   function App() {
//     const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);
//     return (
//       <div style={{ fontSize: t.fontSize, color: t.primaryColor }}>
//         Hello
//         <TweaksPanel>
//           <TweakSection label="Typography" />
//           <TweakSlider label="Font size" value={t.fontSize} min={10} max={32} unit="px"
//                        onChange={(v) => setTweak('fontSize', v)} />
//           <TweakRadio  label="Density" value={t.density}
//                        options={['compact', 'regular', 'comfy']}
//                        onChange={(v) => setTweak('density', v)} />
//           <TweakSection label="Theme" />
//           <TweakColor  label="Primary" value={t.primaryColor}
//                        onChange={(v) => setTweak('primaryColor', v)} />
//           <TweakToggle label="Dark mode" value={t.dark}
//                        onChange={(v) => setTweak('dark', v)} />
//         </TweaksPanel>
//       </div>
//     );
//   }
//
// ─────────────────────────────────────────────────────────────────────────────

const __TWEAKS_STYLE = `
  .twk-panel{position:fixed;right:16px;bottom:16px;z-index:2147483646;width:280px;
    max-height:calc(100vh - 32px);display:flex;flex-direction:column;
    background:rgba(250,249,247,.78);color:#29261b;
    -webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);
    border:.5px solid rgba(255,255,255,.6);border-radius:14px;
    box-shadow:0 1px 0 rgba(255,255,255,.5) inset,0 12px 40px rgba(0,0,0,.18);
    font:11.5px/1.4 ui-sans-serif,system-ui,-apple-system,sans-serif;overflow:hidden}
  .twk-hd{display:flex;align-items:center;justify-content:space-between;
    padding:10px 8px 10px 14px;cursor:move;user-select:none}
  .twk-hd b{font-size:12px;font-weight:600;letter-spacing:.01em}
  .twk-x{appearance:none;border:0;background:transparent;color:rgba(41,38,27,.55);
    width:22px;height:22px;border-radius:6px;cursor:default;font-size:13px;line-height:1}
  .twk-x:hover{background:rgba(0,0,0,.06);color:#29261b}
  .twk-body{padding:2px 14px 14px;display:flex;flex-direction:column;gap:10px;
    overflow-y:auto;overflow-x:hidden;min-height:0;
    scrollbar-width:thin;scrollbar-color:rgba(0,0,0,.15) transparent}
  .twk-body::-webkit-scrollbar{width:8px}
  .twk-body::-webkit-scrollbar-track{background:transparent;margin:2px}
  .twk-body::-webkit-scrollbar-thumb{background:rgba(0,0,0,.15);border-radius:4px;
    border:2px solid transparent;background-clip:content-box}
  .twk-body::-webkit-scrollbar-thumb:hover{background:rgba(0,0,0,.25);
    border:2px solid transparent;background-clip:content-box}
  .twk-row{display:flex;flex-direction:column;gap:5px}
  .twk-row-h{flex-direction:row;align-items:center;justify-content:space-between;gap:10px}
  .twk-lbl{display:flex;justify-content:space-between;align-items:baseline;
    color:rgba(41,38,27,.72)}
  .twk-lbl>span:first-child{font-weight:500}
  .twk-val{color:rgba(41,38,27,.5);font-variant-numeric:tabular-nums}

  .twk-sect{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
    color:rgba(41,38,27,.45);padding:10px 0 0}
  .twk-sect:first-child{padding-top:0}

  .twk-field{appearance:none;width:100%;height:26px;padding:0 8px;
    border:.5px solid rgba(0,0,0,.1);border-radius:7px;
    background:rgba(255,255,255,.6);color:inherit;font:inherit;outline:none}
  .twk-field:focus{border-color:rgba(0,0,0,.25);background:rgba(255,255,255,.85)}
  select.twk-field{padding-right:22px;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='rgba(0,0,0,.5)' d='M0 0h10L5 6z'/></svg>");
    background-repeat:no-repeat;background-position:right 8px center}

  .twk-slider{appearance:none;-webkit-appearance:none;width:100%;height:4px;margin:6px 0;
    border-radius:999px;background:rgba(0,0,0,.12);outline:none}
  .twk-slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;
    width:14px;height:14px;border-radius:50%;background:#fff;
    border:.5px solid rgba(0,0,0,.12);box-shadow:0 1px 3px rgba(0,0,0,.2);cursor:default}
  .twk-slider::-moz-range-thumb{width:14px;height:14px;border-radius:50%;
    background:#fff;border:.5px solid rgba(0,0,0,.12);box-shadow:0 1px 3px rgba(0,0,0,.2);cursor:default}

  .twk-seg{position:relative;display:flex;padding:2px;border-radius:8px;
    background:rgba(0,0,0,.06);user-select:none}
  .twk-seg-thumb{position:absolute;top:2px;bottom:2px;border-radius:6px;
    background:rgba(255,255,255,.9);box-shadow:0 1px 2px rgba(0,0,0,.12);
    transition:left .15s cubic-bezier(.3,.7,.4,1),width .15s}
  .twk-seg.dragging .twk-seg-thumb{transition:none}
  .twk-seg button{appearance:none;position:relative;z-index:1;flex:1;border:0;
    background:transparent;color:inherit;font:inherit;font-weight:500;min-height:22px;
    border-radius:6px;cursor:default;padding:4px 6px;line-height:1.2;
    overflow-wrap:anywhere}

  .twk-toggle{position:relative;width:32px;height:18px;border:0;border-radius:999px;
    background:rgba(0,0,0,.15);transition:background .15s;cursor:default;padding:0}
  .twk-toggle[data-on="1"]{background:#34c759}
  .twk-toggle i{position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;
    background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.25);transition:transform .15s}
  .twk-toggle[data-on="1"] i{transform:translateX(14px)}

  .twk-num{display:flex;align-items:center;height:26px;padding:0 0 0 8px;
    border:.5px solid rgba(0,0,0,.1);border-radius:7px;background:rgba(255,255,255,.6)}
  .twk-num-lbl{font-weight:500;color:rgba(41,38,27,.6);cursor:ew-resize;
    user-select:none;padding-right:8px}
  .twk-num input{flex:1;min-width:0;height:100%;border:0;background:transparent;
    font:inherit;font-variant-numeric:tabular-nums;text-align:right;padding:0 8px 0 0;
    outline:none;color:inherit;-moz-appearance:textfield}
  .twk-num input::-webkit-inner-spin-button,.twk-num input::-webkit-outer-spin-button{
    -webkit-appearance:none;margin:0}
  .twk-num-unit{padding-right:8px;color:rgba(41,38,27,.45)}

  .twk-btn{appearance:none;height:26px;padding:0 12px;border:0;border-radius:7px;
    background:rgba(0,0,0,.78);color:#fff;font:inherit;font-weight:500;cursor:default}
  .twk-btn:hover{background:rgba(0,0,0,.88)}
  .twk-btn.secondary{background:rgba(0,0,0,.06);color:inherit}
  .twk-btn.secondary:hover{background:rgba(0,0,0,.1)}

  .twk-swatch{appearance:none;-webkit-appearance:none;width:56px;height:22px;
    border:.5px solid rgba(0,0,0,.1);border-radius:6px;padding:0;cursor:default;
    background:transparent;flex-shrink:0}
  .twk-swatch::-webkit-color-swatch-wrapper{padding:0}
  .twk-swatch::-webkit-color-swatch{border:0;border-radius:5.5px}
  .twk-swatch::-moz-color-swatch{border:0;border-radius:5.5px}
`;

// ── useTweaks ───────────────────────────────────────────────────────────────
// Single source of truth for tweak values. setTweak persists via the host
// (__edit_mode_set_keys → host rewrites the EDITMODE block on disk).
function useTweaks(defaults) {
  const [values, setValues] = React.useState(defaults);
  // Accepts either setTweak('key', value) or setTweak({ key: value, ... }) so a
  // useState-style call doesn't write a "[object Object]" key into the persisted
  // JSON block.
  const setTweak = React.useCallback((keyOrEdits, val) => {
    const edits = typeof keyOrEdits === 'object' && keyOrEdits !== null
      ? keyOrEdits : { [keyOrEdits]: val };
    setValues((prev) => ({ ...prev, ...edits }));
    window.parent.postMessage({ type: '__edit_mode_set_keys', edits }, '*');
  }, []);
  return [values, setTweak];
}

// ── TweaksPanel ─────────────────────────────────────────────────────────────
// Floating shell. Registers the protocol listener BEFORE announcing
// availability — if the announce ran first, the host's activate could land
// before our handler exists and the toolbar toggle would silently no-op.
// The close button posts __edit_mode_dismissed so the host's toolbar toggle
// flips off in lockstep; the host echoes __deactivate_edit_mode back which
// is what actually hides the panel.
function TweaksPanel({ title = 'Tweaks', children }) {
  const [open, setOpen] = React.useState(false);
  const dragRef = React.useRef(null);
  const offsetRef = React.useRef({ x: 16, y: 16 });
  const PAD = 16;

  const clampToViewport = React.useCallback(() => {
    const panel = dragRef.current;
    if (!panel) return;
    const w = panel.offsetWidth, h = panel.offsetHeight;
    const maxRight = Math.max(PAD, window.innerWidth - w - PAD);
    const maxBottom = Math.max(PAD, window.innerHeight - h - PAD);
    offsetRef.current = {
      x: Math.min(maxRight, Math.max(PAD, offsetRef.current.x)),
      y: Math.min(maxBottom, Math.max(PAD, offsetRef.current.y)),
    };
    panel.style.right = offsetRef.current.x + 'px';
    panel.style.bottom = offsetRef.current.y + 'px';
  }, []);

  React.useEffect(() => {
    if (!open) return;
    clampToViewport();
    if (typeof ResizeObserver === 'undefined') {
      window.addEventListener('resize', clampToViewport);
      return () => window.removeEventListener('resize', clampToViewport);
    }
    const ro = new ResizeObserver(clampToViewport);
    ro.observe(document.documentElement);
    return () => ro.disconnect();
  }, [open, clampToViewport]);

  React.useEffect(() => {
    const onMsg = (e) => {
      const t = e?.data?.type;
      if (t === '__activate_edit_mode') setOpen(true);
      else if (t === '__deactivate_edit_mode') setOpen(false);
    };
    window.addEventListener('message', onMsg);
    window.parent.postMessage({ type: '__edit_mode_available' }, '*');
    return () => window.removeEventListener('message', onMsg);
  }, []);

  const dismiss = () => {
    setOpen(false);
    window.parent.postMessage({ type: '__edit_mode_dismissed' }, '*');
  };

  const onDragStart = (e) => {
    const panel = dragRef.current;
    if (!panel) return;
    const r = panel.getBoundingClientRect();
    const sx = e.clientX, sy = e.clientY;
    const startRight = window.innerWidth - r.right;
    const startBottom = window.innerHeight - r.bottom;
    const move = (ev) => {
      offsetRef.current = {
        x: startRight - (ev.clientX - sx),
        y: startBottom - (ev.clientY - sy),
      };
      clampToViewport();
    };
    const up = () => {
      window.removeEventListener('mousemove', move);
      window.removeEventListener('mouseup', up);
    };
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', up);
  };

  if (!open) return null;
  return (
    <>
      <style>{__TWEAKS_STYLE}</style>
      <div ref={dragRef} className="twk-panel" data-noncommentable=""
           style={{ right: offsetRef.current.x, bottom: offsetRef.current.y }}>
        <div className="twk-hd" onMouseDown={onDragStart}>
          <b>{title}</b>
          <button className="twk-x" aria-label="Close tweaks"
                  onMouseDown={(e) => e.stopPropagation()}
                  onClick={dismiss}>✕</button>
        </div>
        <div className="twk-body">{children}</div>
      </div>
    </>
  );
}

// ── Layout helpers ──────────────────────────────────────────────────────────

function TweakSection({ label, children }) {
  return (
    <>
      <div className="twk-sect">{label}</div>
      {children}
    </>
  );
}

function TweakRow({ label, value, children, inline = false }) {
  return (
    <div className={inline ? 'twk-row twk-row-h' : 'twk-row'}>
      <div className="twk-lbl">
        <span>{label}</span>
        {value != null && <span className="twk-val">{value}</span>}
      </div>
      {children}
    </div>
  );
}

// ── Controls ────────────────────────────────────────────────────────────────

function TweakSlider({ label, value, min = 0, max = 100, step = 1, unit = '', onChange }) {
  return (
    <TweakRow label={label} value={`${value}${unit}`}>
      <input type="range" className="twk-slider" min={min} max={max} step={step}
             value={value} onChange={(e) => onChange(Number(e.target.value))} />
    </TweakRow>
  );
}

function TweakToggle({ label, value, onChange }) {
  return (
    <div className="twk-row twk-row-h">
      <div className="twk-lbl"><span>{label}</span></div>
      <button type="button" className="twk-toggle" data-on={value ? '1' : '0'}
              role="switch" aria-checked={!!value}
              onClick={() => onChange(!value)}><i /></button>
    </div>
  );
}

function TweakRadio({ label, value, options, onChange }) {
  const trackRef = React.useRef(null);
  const [dragging, setDragging] = React.useState(false);
  const opts = options.map((o) => (typeof o === 'object' ? o : { value: o, label: o }));
  const idx = Math.max(0, opts.findIndex((o) => o.value === value));
  const n = opts.length;

  // The active value is read by pointer-move handlers attached for the lifetime
  // of a drag — ref it so a stale closure doesn't fire onChange for every move.
  const valueRef = React.useRef(value);
  valueRef.current = value;

  const segAt = (clientX) => {
    const r = trackRef.current.getBoundingClientRect();
    const inner = r.width - 4;
    const i = Math.floor(((clientX - r.left - 2) / inner) * n);
    return opts[Math.max(0, Math.min(n - 1, i))].value;
  };

  const onPointerDown = (e) => {
    setDragging(true);
    const v0 = segAt(e.clientX);
    if (v0 !== valueRef.current) onChange(v0);
    const move = (ev) => {
      if (!trackRef.current) return;
      const v = segAt(ev.clientX);
      if (v !== valueRef.current) onChange(v);
    };
    const up = () => {
      setDragging(false);
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  };

  return (
    <TweakRow label={label}>
      <div ref={trackRef} role="radiogroup" onPointerDown={onPointerDown}
           className={dragging ? 'twk-seg dragging' : 'twk-seg'}>
        <div className="twk-seg-thumb"
             style={{ left: `calc(2px + ${idx} * (100% - 4px) / ${n})`,
                      width: `calc((100% - 4px) / ${n})` }} />
        {opts.map((o) => (
          <button key={o.value} type="button" role="radio" aria-checked={o.value === value}>
            {o.label}
          </button>
        ))}
      </div>
    </TweakRow>
  );
}

function TweakSelect({ label, value, options, onChange }) {
  return (
    <TweakRow label={label}>
      <select className="twk-field" value={value} onChange={(e) => onChange(e.target.value)}>
        {options.map((o) => {
          const v = typeof o === 'object' ? o.value : o;
          const l = typeof o === 'object' ? o.label : o;
          return <option key={v} value={v}>{l}</option>;
        })}
      </select>
    </TweakRow>
  );
}

function TweakText({ label, value, placeholder, onChange }) {
  return (
    <TweakRow label={label}>
      <input className="twk-field" type="text" value={value} placeholder={placeholder}
             onChange={(e) => onChange(e.target.value)} />
    </TweakRow>
  );
}

function TweakNumber({ label, value, min, max, step = 1, unit = '', onChange }) {
  const clamp = (n) => {
    if (min != null && n < min) return min;
    if (max != null && n > max) return max;
    return n;
  };
  const startRef = React.useRef({ x: 0, val: 0 });
  const onScrubStart = (e) => {
    e.preventDefault();
    startRef.current = { x: e.clientX, val: value };
    const decimals = (String(step).split('.')[1] || '').length;
    const move = (ev) => {
      const dx = ev.clientX - startRef.current.x;
      const raw = startRef.current.val + dx * step;
      const snapped = Math.round(raw / step) * step;
      onChange(clamp(Number(snapped.toFixed(decimals))));
    };
    const up = () => {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  };
  return (
    <div className="twk-num">
      <span className="twk-num-lbl" onPointerDown={onScrubStart}>{label}</span>
      <input type="number" value={value} min={min} max={max} step={step}
             onChange={(e) => onChange(clamp(Number(e.target.value)))} />
      {unit && <span className="twk-num-unit">{unit}</span>}
    </div>
  );
}

function TweakColor({ label, value, onChange }) {
  return (
    <div className="twk-row twk-row-h">
      <div className="twk-lbl"><span>{label}</span></div>
      <input type="color" className="twk-swatch" value={value}
             onChange={(e) => onChange(e.target.value)} />
    </div>
  );
}

function TweakButton({ label, onClick, secondary = false }) {
  return (
    <button type="button" className={secondary ? 'twk-btn secondary' : 'twk-btn'}
            onClick={onClick}>{label}</button>
  );
}

Object.assign(window, {
  useTweaks, TweaksPanel, TweakSection, TweakRow,
  TweakSlider, TweakToggle, TweakRadio, TweakSelect,
  TweakText, TweakNumber, TweakColor, TweakButton,
});
</script>
<script type="text/babel" data-presets="react">
/* global React */
const { useState, useEffect, useMemo, useRef, useCallback } = React;

// ===== Icons (inline SVG, 16px default) =====
const Icon = ({ name, size = 16, className = '', strokeWidth = 1.75 }) => {
  const props = {
    width: size, height: size, viewBox: '0 0 24 24', fill: 'none',
    stroke: 'currentColor', strokeWidth, strokeLinecap: 'round', strokeLinejoin: 'round',
    className,
  };
  const paths = {
    dashboard: <><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></>,
    promo: <><path d="M20 12V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v5"/><path d="M4 12v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><path d="M2 12h20"/><path d="M12 5v14"/></>,
    requests: <><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></>,
    partners: <><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></>,
    products: <><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></>,
    reports: <><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-5"/></>,
    settings: <><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></>,
    search: <><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></>,
    plus: <><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></>,
    download: <><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></>,
    filter: <><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></>,
    chevron: <><polyline points="9 18 15 12 9 6"/></>,
    chevronDown: <><polyline points="6 9 12 15 18 9"/></>,
    close: <><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></>,
    check: <><polyline points="20 6 9 17 4 12"/></>,
    edit: <><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></>,
    trash: <><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></>,
    mail: <><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></>,
    calendar: <><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></>,
    package: <><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></>,
    sparkle: <><path d="M12 3l1.9 5.5L19 10l-5.1 1.5L12 17l-1.9-5.5L5 10l5.1-1.5z"/></>,
    moon: <><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></>,
    sun: <><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M4.93 4.93l1.41 1.41"/><path d="M17.66 17.66l1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="M4.93 19.07l1.41-1.41"/><path d="M17.66 6.34l1.41-1.41"/></>,
    alert: <><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="17" r="0.5"/></>,
    info: <><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><circle cx="12" cy="8" r="0.5"/></>,
    bell: <><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></>,
    user: <><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></>,
    folder: <><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></>,
    excel: <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M8 13l4 4M12 13l-4 4"/></>,
    barChart: <><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></>,
    refresh: <><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></>,
    arrow: <><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></>,
    drop: <><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></>,
  };
  return <svg {...props}>{paths[name] || null}</svg>;
};

// ===== Helpers =====
function cls(...args) { return args.filter(Boolean).join(' '); }
function fmtNum(n) {
  if (n == null) return '—';
  return new Intl.NumberFormat('en-US').format(n).replace(/,/g, ' ');
}
function fmtMoney(n) {
  if (n == null) return '—';
  return '₸ ' + fmtNum(n);
}
function fmtLitres(n) {
  if (n == null) return '—';
  return fmtNum(n) + ' L';
}
function fmtDate(s, locale = 'en') {
  if (!s) return '—';
  const d = new Date(s);
  return d.toLocaleDateString(locale === 'ru' ? 'ru-RU' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
function pct(used, quota) {
  if (!quota || !used) return 0;
  return Math.min(100, Math.round((used / quota) * 100));
}
function statusBadgeKind(s) {
  return ({active:'ok', pending:'warn', draft:'draft', expired:'info', cancelled:'bad'})[s] || '';
}
function aiBadgeKind(s) {
  return ({verified:'ok', flag:'warn', mismatch:'bad'})[s] || '';
}
function aiIcon(s) {
  return ({verified:'check', flag:'alert', mismatch:'close'})[s] || 'info';
}

// ===== Reusable bits =====
const Checkbox = ({ checked, indet, onChange }) => (
  <span className={cls('checkbox', checked && 'checked', indet && 'indet')} onClick={(e) => { e.stopPropagation(); onChange && onChange(!checked); }}>
    {checked && !indet && <Icon name="check" size={11} strokeWidth={2.5} />}
  </span>
);

const Badge = ({ kind, children, dot }) => (
  <span className={cls('badge', kind, dot && 'dot')}>{children}</span>
);

const StatusBadge = ({ status, t }) => (
  <Badge kind={statusBadgeKind(status)} dot>{t.status[status]}</Badge>
);

const TypeBadge = ({ type, t }) => (
  <span className="badge badge-type">{type === 'nplus1' ? 'N + 1' : (t.promoTypes.money.split(' ')[0])}</span>
);

const Toast = ({ msg, onDone }) => {
  useEffect(() => { const id = setTimeout(onDone, 2400); return () => clearTimeout(id); }, []);
  return <div className="toast"><Icon name="check" size={14} strokeWidth={2.5} />{msg}</div>;
};

Object.assign(window, { Icon, Checkbox, Badge, StatusBadge, TypeBadge, Toast, cls, fmtNum, fmtMoney, fmtLitres, fmtDate, pct, statusBadgeKind, aiBadgeKind, aiIcon });
</script>
<script type="text/babel" data-presets="react">
/* global React, PARTNERS, CHANNELS, PRODUCTS, ACTIVITY_TYPES, Icon, Checkbox, cls */
const { useState: useStateTP, useMemo: useMemoTP } = React;

// Tree picker for Partner → Sale point → Channel
function TreePicker({ value, onChange, lang, partnerFilter }) {
  // value: { partnerIds: Set, salePointIds: Set }
  const [expanded, setExpanded] = useStateTP(() => new Set(['p-001']));
  const partners = useMemoTP(
    () => partnerFilter ? PARTNERS.filter(partnerFilter) : PARTNERS,
    [partnerFilter]
  );

  const toggle = (id) => {
    const next = new Set(expanded);
    next.has(id) ? next.delete(id) : next.add(id);
    setExpanded(next);
  };

  const setPartner = (p, on) => {
    const sp = new Set(value.salePointIds);
    const pp = new Set(value.partnerIds);
    p.salePoints.forEach((s) => on ? sp.add(s.id) : sp.delete(s.id));
    on ? pp.add(p.id) : pp.delete(p.id);
    onChange({ partnerIds: pp, salePointIds: sp });
  };

  const setSP = (p, s, on) => {
    const sp = new Set(value.salePointIds);
    on ? sp.add(s.id) : sp.delete(s.id);
    const pp = new Set(value.partnerIds);
    const allOn = p.salePoints.every((x) => sp.has(x.id));
    if (allOn) pp.add(p.id); else pp.delete(p.id);
    onChange({ partnerIds: pp, salePointIds: sp });
  };

  const channelLabel = (id) => {
    const search = (n) => {
      if (n.id === id) return n['label_' + lang];
      if (n.children) for (const c of n.children) { const r = search(c); if (r) return r; }
      return null;
    };
    return search(CHANNELS.ontrade) || search(CHANNELS.offtrade) || id;
  };

  return (
    <div className="tree">
      {partners.map((p) => {
        const allOn = p.salePoints.every((s) => value.salePointIds.has(s.id));
        const someOn = !allOn && p.salePoints.some((s) => value.salePointIds.has(s.id));
        const isOpen = expanded.has(p.id);
        return (
          <div key={p.id}>
            <div className="tree-node">
              <span className="twisty" onClick={() => toggle(p.id)}>
                <Icon name={isOpen ? 'chevronDown' : 'chevron'} size={12} />
              </span>
              <Checkbox checked={allOn} indet={someOn} onChange={(v) => setPartner(p, v)} />
              <label onClick={() => toggle(p.id)}>
                <Icon name="folder" size={14} className="" />
                <span style={{ fontWeight: 600 }}>{p.name}</span>
                <span className="count">· {p.city} · {p.salePoints.length} pts</span>
              </label>
            </div>
            {isOpen && (
              <div className="tree-children">
                {p.salePoints.map((s) => (
                  <div className="tree-node" key={s.id}>
                    <span style={{ width: 16 }} />
                    <Checkbox checked={value.salePointIds.has(s.id)} onChange={(v) => setSP(p, s, v)} />
                    <label>
                      <Icon name="package" size={13} />
                      <span>{s.name}</span>
                      <span className="count">· {channelLabel(s.channel)}</span>
                    </label>
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}

window.TreePicker = TreePicker;
</script>
<script type="text/babel" data-presets="react">
/* global React, PARTNERS, PRODUCTS, ACTIVITY_TYPES, CHANNELS, Icon, Checkbox, Badge, cls, TreePicker */
const { useState: useStateW, useMemo: useMemoW } = React;

function findChannelLabel(id, lang) {
  const search = (n) => {
    if (n.id === id) return n['label_' + lang];
    if (n.children) for (const c of n.children) { const r = search(c); if (r) return r; }
    return null;
  };
  return search(CHANNELS.ontrade) || search(CHANNELS.offtrade) || id;
}

function CreatePromoForm({ t, lang, onClose, onCreate, layout = 'wizard' }) {
  // Shared state
  const [step, setStep] = useStateW(0);
  const [segment, setSegment] = useStateW('offtrade');
  const [type, setType] = useStateW('nplus1');
  const [scope, setScope] = useStateW({ partnerIds: new Set(), salePointIds: new Set() });
  const [productSel, setProductSel] = useStateW(new Set(['EFS-PIL-050']));
  const [params, setParams] = useStateW({
    nValue: 10,
    quotaLitres: 2000,
    quotaMoney: 500000,
    startDate: new Date().toISOString().slice(0,10),
    endDate: new Date(Date.now()+60*86400000).toISOString().slice(0,10),
  });
  const [emailEnabled, setEmailEnabled] = useStateW(true);

  const partnersInSegment = useMemoW(() => PARTNERS.filter((p) => p.segment === segment), [segment]);
  const productList = PRODUCTS;

  const partnerSummary = useMemoW(() => {
    const partners = PARTNERS.filter((p) => scope.partnerIds.has(p.id) || p.salePoints.some((s) => scope.salePointIds.has(s.id)));
    return partners.map((p) => p.name).join(', ') || (lang === 'ru' ? '— не выбрано —' : '— none selected —');
  }, [scope, lang]);

  const code = useMemoW(() => 'PR-' + String(10445 + Math.floor(Math.random() * 30)).padStart(5, '0'), []);

  const valid = scope.salePointIds.size > 0 && productSel.size > 0;

  // ===== STEP CONTENT (used by both layouts) =====
  const StepChannelType = (
    <>
      <h3 style={{ marginTop: 0 }}>{lang === 'ru' ? 'Канал и тип акции' : 'Channel & activity type'}</h3>
      <div className="field">
        <label>{lang === 'ru' ? 'Сегмент канала' : 'Channel segment'}</label>
        <div className="type-grid">
          <div className={cls('type-card', segment === 'ontrade' && 'selected')} onClick={() => { setSegment('ontrade'); setType('nplus1'); }}>
            <div className="t-title">On trade</div>
            <div className="t-desc">HoReCa · SpecPegas</div>
            <div className="t-desc" style={{ fontSize: 11 }}>{lang === 'ru' ? 'Только N + 1' : 'N + 1 only'}</div>
          </div>
          <div className={cls('type-card', segment === 'offtrade' && 'selected')} onClick={() => setSegment('offtrade')}>
            <div className="t-title">Off trade</div>
            <div className="t-desc">Sale point · Diot · Wholesale</div>
            <div className="t-desc" style={{ fontSize: 11 }}>{lang === 'ru' ? 'N + 1 и N + KZT' : 'N + 1 and N + KZT'}</div>
          </div>
        </div>
      </div>
      <div className="field" style={{ marginTop: 18 }}>
        <label>{t.fields.type}</label>
        <div className="type-grid">
          {ACTIVITY_TYPES.map((at) => {
            const allowed = at.allowedIn.includes(segment);
            return (
              <div key={at.id} className={cls('type-card', type === at.id && 'selected', !allowed && 'disabled')} onClick={() => allowed && setType(at.id)}>
                <div className="t-title">{at['label_' + lang]}</div>
                <div className="t-desc">{at['description_' + lang]}</div>
              </div>
            );
          })}
        </div>
      </div>
    </>
  );

  const StepScope = (
    <>
      <h3 style={{ marginTop: 0 }}>{lang === 'ru' ? 'Партнёр и охват' : 'Partner & scope'}</h3>
      <div className="hint" style={{ marginBottom: 10 }}>
        {lang === 'ru'
          ? 'Выберите партнёров и точки продаж. Один партнёр или несколько — система свяжет автоматически.'
          : 'Tick partners and individual sale points. The system will resolve channels automatically.'}
      </div>
      <div style={{ border: '1px solid var(--border)', borderRadius: 10, padding: 10, maxHeight: 360, overflow: 'auto' }} className="scroll-hint">
        <TreePicker value={scope} onChange={setScope} lang={lang} partnerFilter={(p) => p.segment === segment} />
      </div>
      <div className="hint" style={{ marginTop: 8 }}>
        <strong>{scope.salePointIds.size}</strong> {lang === 'ru' ? 'точек выбрано' : 'sale points selected'} · {partnerSummary}
      </div>
    </>
  );

  const toggleProd = (sku) => {
    const next = new Set(productSel);
    next.has(sku) ? next.delete(sku) : next.add(sku);
    setProductSel(next);
  };

  const StepProducts = (
    <>
      <h3 style={{ marginTop: 0 }}>{t.fields.products}</h3>
      <div className="hint" style={{ marginBottom: 10 }}>
        {lang === 'ru' ? 'Можно выбрать несколько SKU.' : 'Pick one or more SKUs to include in this promo.'}
      </div>
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
        {productList.map((p) => (
          <div
            key={p.sku}
            onClick={() => toggleProd(p.sku)}
            className={cls('type-card', productSel.has(p.sku) && 'selected')}
            style={{ padding: 12, flexDirection: 'row', alignItems: 'center', gap: 10 }}
          >
            <Checkbox checked={productSel.has(p.sku)} onChange={() => toggleProd(p.sku)} />
            <div>
              <div className="t-title" style={{ fontSize: 13 }}>{p.name}</div>
              <div className="t-desc" style={{ fontFamily: 'var(--font-mono)' }}>{p.sku} · {p.volume} L</div>
            </div>
          </div>
        ))}
      </div>
    </>
  );

  const StepParams = (
    <>
      <h3 style={{ marginTop: 0 }}>{t.sections.parameters}</h3>
      {type === 'nplus1' && (
        <div className="field">
          <label>{t.fields.nValue}</label>
          <input className="input" type="number" min="1" value={params.nValue}
            onChange={(e) => setParams({ ...params, nValue: +e.target.value })} />
          <div className="hint">
            {lang === 'ru'
              ? `За каждые ${params.nValue} литров — 1 литр в подарок.`
              : `For every ${params.nValue} litres purchased, 1 litre is given for free.`}
          </div>
        </div>
      )}
      {type === 'nplus1' ? (
        <div className="field">
          <label>{t.fields.quotaLitres}</label>
          <input className="input" type="number" value={params.quotaLitres}
            onChange={(e) => setParams({ ...params, quotaLitres: +e.target.value })} />
        </div>
      ) : (
        <div className="field">
          <label>{t.fields.quotaMoney}</label>
          <input className="input" type="number" value={params.quotaMoney}
            onChange={(e) => setParams({ ...params, quotaMoney: +e.target.value })} />
        </div>
      )}
      <div className="row-2">
        <div className="field">
          <label>{t.fields.startDate}</label>
          <input className="input" type="date" value={params.startDate}
            onChange={(e) => setParams({ ...params, startDate: e.target.value })} />
        </div>
        <div className="field">
          <label>{t.fields.endDate}</label>
          <input className="input" type="date" value={params.endDate}
            onChange={(e) => setParams({ ...params, endDate: e.target.value })} />
        </div>
      </div>
    </>
  );

  const productNames = [...productSel].map((s) => PRODUCTS.find((p) => p.sku === s)?.name).filter(Boolean).join(', ');
  const emailSubject = (t.placeholders.emailSubject)
    .replace('{code}', code).replace('{partner}', partnerSummary);
  const quotaStr = type === 'nplus1' ? (params.quotaLitres + ' L') : ('₸ ' + params.quotaMoney);
  const emailBody = (t.placeholders.emailBody)
    .replace('{code}', code)
    .replace('{start}', params.startDate)
    .replace('{end}', params.endDate)
    .replace('{type}', type === 'nplus1' ? `N + 1 (N=${params.nValue})` : (lang === 'ru' ? 'N + KZT' : 'N + KZT'))
    .replace('{products}', productNames)
    .replace('{quota}', quotaStr);

  const StepEmail = (
    <>
      <h3 style={{ marginTop: 0 }}>{t.sections.notification}</h3>
      <div className="field" style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Checkbox checked={emailEnabled} onChange={setEmailEnabled} />
        <label style={{ marginBottom: 0 }}>
          {lang === 'ru' ? 'Отправить письмо партнёру через Outlook при создании' : 'Send Outlook notification email to partner on create'}
        </label>
      </div>
      <div className="email" style={{ marginTop: 12 }}>
        <div className="email-head">
          <span className="lk">{t.fields.recipient}</span><span className="vl">partner@example.com</span>
          <span className="lk">{t.fields.subject}</span><span className="vl"><strong>{emailSubject}</strong></span>
        </div>
        <div className="email-body">{emailBody}</div>
      </div>
      <div className="divider" />
      <div className="section" style={{ margin: 0, padding: 14 }}>
        <h3>{lang === 'ru' ? 'Сводка' : 'Summary'}</h3>
        <div className="kv-grid">
          <div className="kv"><span className="k">{t.fields.code}</span><span className="v" style={{ fontFamily: 'var(--font-mono)' }}>{code}</span></div>
          <div className="kv"><span className="k">{t.fields.type}</span><span className="v">{ACTIVITY_TYPES.find((a) => a.id === type)['label_' + lang]}</span></div>
          <div className="kv"><span className="k">{t.fields.partner}</span><span className="v">{partnerSummary}</span></div>
          <div className="kv"><span className="k">{t.fields.products}</span><span className="v">{productSel.size} SKU</span></div>
          <div className="kv"><span className="k">{t.fields.period}</span><span className="v">{params.startDate} → {params.endDate}</span></div>
          <div className="kv"><span className="k">{t.fields.quota}</span><span className="v">{quotaStr}</span></div>
        </div>
      </div>
    </>
  );

  const stepContent = [StepChannelType, StepScope, StepProducts, StepParams, StepEmail];

  // ===== Layout: WIZARD =====
  if (layout === 'wizard') {
    return (
      <>
        <div className="drawer-head">
          <div style={{ flex: 1 }}>
            <h2>{t.actions.newPromo}</h2>
            <div className="sub">{t.misc.step} {step + 1} {t.misc.of} {t.wizardSteps.length} · <span style={{ fontFamily: 'var(--font-mono)' }}>{code}</span></div>
          </div>
          <button className="icon-btn" onClick={onClose}><Icon name="close" /></button>
        </div>
        <div className="steps">
          {t.wizardSteps.map((label, i) => (
            <div key={i} className={cls('step', i === step && 'active', i < step && 'done')}>
              <span className="num">{i < step ? '✓' : i + 1}</span>{label}
            </div>
          ))}
        </div>
        <div className="drawer-body">{stepContent[step]}</div>
        <div className="drawer-foot">
          <button className="btn" onClick={onClose}>{t.actions.cancel}</button>
          <div style={{ flex: 1 }} />
          {step > 0 && <button className="btn" onClick={() => setStep(step - 1)}>{t.actions.back}</button>}
          {step < t.wizardSteps.length - 1 && (
            <button className="btn primary" onClick={() => setStep(step + 1)}>{t.actions.next}</button>
          )}
          {step === t.wizardSteps.length - 1 && (
            <>
              <button className="btn" onClick={() => onCreate({ code, status: 'draft' })}>{t.actions.sendDraft}</button>
              <button className="btn primary" disabled={!valid} onClick={() => onCreate({ code, status: emailEnabled ? 'pending' : 'draft', emailSent: emailEnabled })}>
                <Icon name="mail" size={14} />{emailEnabled ? t.actions.sendEmail : t.actions.create}
              </button>
            </>
          )}
        </div>
      </>
    );
  }

  // ===== Layout: SIDE PANEL (single long form) =====
  return (
    <>
      <div className="drawer-head">
        <div style={{ flex: 1 }}>
          <h2>{t.actions.newPromo}</h2>
          <div className="sub" style={{ fontFamily: 'var(--font-mono)' }}>{code}</div>
        </div>
        <button className="icon-btn" onClick={onClose}><Icon name="close" /></button>
      </div>
      <div className="drawer-body">
        <div className="section">{StepChannelType}</div>
        <div className="section">{StepScope}</div>
        <div className="section">{StepProducts}</div>
        <div className="section">{StepParams}</div>
        <div className="section">{StepEmail}</div>
      </div>
      <div className="drawer-foot">
        <button className="btn" onClick={onClose}>{t.actions.cancel}</button>
        <div style={{ flex: 1 }} />
        <button className="btn" onClick={() => onCreate({ code, status: 'draft' })}>{t.actions.sendDraft}</button>
        <button className="btn primary" disabled={!valid} onClick={() => onCreate({ code, status: emailEnabled ? 'pending' : 'draft', emailSent: emailEnabled })}>
          <Icon name="mail" size={14} />{emailEnabled ? t.actions.sendEmail : t.actions.create}
        </button>
      </div>
    </>
  );
}

window.CreatePromoForm = CreatePromoForm;
window.findChannelLabel = findChannelLabel;
</script>
<script type="text/babel" data-presets="react">
/* global React, PARTNERS, PRODUCTS, ACTIVITY_TYPES, Icon, Badge, StatusBadge, TypeBadge, Checkbox,
   cls, fmtNum, fmtMoney, fmtLitres, fmtDate, pct, findChannelLabel */
const { useState: useStateD, useMemo: useMemoD } = React;

function PromoDetail({ promo, t, lang, onClose, onPatch, pushToast }) {
  const partner = PARTNERS.find((p) => p.id === promo.partnerId);
  const [op, setOp] = useStateD(null); // 'cancel' | 'quota' | 'period' | 'product' | 'salepoint' | 'email'
  const [quotaInput, setQuotaInput] = useStateD(promo.quotaLitres ?? promo.quotaMoney);
  const [period, setPeriod] = useStateD({ start: promo.startDate, end: promo.endDate });
  const [newProd, setNewProd] = useStateD('');
  const [newSP, setNewSP] = useStateD('');
  const [cancelReason, setCancelReason] = useStateD('');

  const usagePct = pct(promo.usedLitres, promo.quotaLitres) || pct(promo.usedMoney, promo.quotaMoney);
  const progressKind = usagePct >= 95 ? 'bad' : usagePct >= 75 ? 'warn' : '';

  const channels = [...new Set(promo.channelIds)].map((id) => findChannelLabel(id, lang));
  const productObjs = promo.products.map((sku) => PRODUCTS.find((p) => p.sku === sku)).filter(Boolean);
  const salePoints = (partner?.salePoints || []).filter((s) => promo.salePointIds.includes(s.id));
  const availableProds = PRODUCTS.filter((p) => !promo.products.includes(p.sku));
  const availableSPs = (partner?.salePoints || []).filter((s) => !promo.salePointIds.includes(s.id));

  const submitOp = () => {
    if (op === 'cancel') {
      onPatch({ status: 'cancelled', cancelReason });
      pushToast(lang === 'ru' ? 'Промо отменено · письмо отправлено' : 'Promo cancelled · email sent');
    } else if (op === 'quota') {
      const patch = promo.type === 'nplus1' ? { quotaLitres: +quotaInput } : { quotaMoney: +quotaInput };
      onPatch(patch);
      pushToast(lang === 'ru' ? 'Квота обновлена' : 'Quota updated');
    } else if (op === 'period') {
      onPatch({ startDate: period.start, endDate: period.end });
      pushToast(lang === 'ru' ? 'Период изменён' : 'Period changed');
    } else if (op === 'product') {
      onPatch({ products: [...promo.products, newProd] });
      pushToast(lang === 'ru' ? 'Продукт добавлен' : 'Product added');
    } else if (op === 'salepoint') {
      onPatch({ salePointIds: [...promo.salePointIds, newSP] });
      pushToast(lang === 'ru' ? 'Точка добавлена' : 'Sale point added');
    }
    setOp(null);
  };

  return (
    <>
      <div className="drawer-head">
        <div style={{ flex: 1, minWidth: 0 }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 10, flexWrap: 'wrap' }}>
            <span className="code-tag">{promo.code}</span>
            <StatusBadge status={promo.status} t={t} />
            <TypeBadge type={promo.type} t={t} />
          </div>
          <h2 style={{ marginTop: 8 }}>{partner?.name}</h2>
          <div className="sub">{partner?.city} · {channels.join(', ')}</div>
        </div>
        <button className="icon-btn" onClick={onClose}><Icon name="close" /></button>
      </div>

      <div className="drawer-body">
        <div className="section">
          <h3>{t.sections.overview}</h3>
          <div className="kv-grid">
            <div className="kv editable">
              <span className="k">{t.fields.type}</span>
              <span className="v">{ACTIVITY_TYPES.find((a) => a.id === promo.type)?.['label_' + lang]}</span>
            </div>
            <div className="kv editable">
              <span className="k">{t.fields.period}</span>
              <span className="v">{fmtDate(promo.startDate, lang)} → {fmtDate(promo.endDate, lang)}
                <button className="edit-btn" onClick={() => setOp('period')}><Icon name="edit" size={12} /></button>
              </span>
            </div>
            <div className="kv editable">
              <span className="k">{t.fields.quota}</span>
              <span className="v">
                {promo.type === 'nplus1' ? fmtLitres(promo.quotaLitres) : fmtMoney(promo.quotaMoney)}
                <button className="edit-btn" onClick={() => setOp('quota')}><Icon name="edit" size={12} /></button>
              </span>
            </div>
            <div className="kv">
              <span className="k">{t.fields.used}</span>
              <span className="v">
                {promo.type === 'nplus1' ? fmtLitres(promo.usedLitres) : fmtMoney(promo.usedMoney)} ({usagePct}%)
              </span>
            </div>
            {promo.type === 'nplus1' && (
              <div className="kv">
                <span className="k">{t.fields.nValue}</span>
                <span className="v">N = {promo.nValue}</span>
              </div>
            )}
            <div className="kv">
              <span className="k">{t.fields.createdBy}</span>
              <span className="v">{promo.createdBy}</span>
            </div>
          </div>
          <div style={{ marginTop: 14 }}>
            <div className="hint" style={{ marginBottom: 4, display: 'flex', justifyContent: 'space-between' }}>
              <span>{t.fields.progress}</span>
              <span style={{ fontFamily: 'var(--font-mono)' }}>{usagePct}%</span>
            </div>
            <div className={cls('progress', progressKind)} style={{ width: '100%' }}>
              <span style={{ width: usagePct + '%' }} />
            </div>
          </div>
        </div>

        <div className="section">
          <h3>{t.sections.scope}</h3>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 }}>
            <strong style={{ fontSize: 13 }}>{t.fields.salePoint} ({salePoints.length})</strong>
            <button className="btn sm" onClick={() => setOp('salepoint')} disabled={availableSPs.length === 0}>
              <Icon name="plus" size={12} />{t.actions.addSalePoint}
            </button>
          </div>
          <div style={{ display: 'grid', gap: 6 }}>
            {salePoints.map((s) => (
              <div key={s.id} style={{ display: 'flex', justifyContent: 'space-between', padding: '7px 10px', border: '1px solid var(--border)', borderRadius: 8, fontSize: 12.5 }}>
                <span><Icon name="package" size={12} /> <strong>{s.name}</strong> · <span style={{ color: 'var(--text-3)' }}>{s.address}</span></span>
                <Badge kind="info">{findChannelLabel(s.channel, lang)}</Badge>
              </div>
            ))}
          </div>
        </div>

        <div className="section">
          <h3>{t.fields.products}</h3>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, marginBottom: 10 }}>
            {productObjs.map((p) => (
              <span key={p.sku} className="prod-chip"><strong>{p.sku}</strong> · {p.name}</span>
            ))}
          </div>
          <button className="btn sm" onClick={() => { setNewProd(availableProds[0]?.sku || ''); setOp('product'); }} disabled={availableProds.length === 0}>
            <Icon name="plus" size={12} />{t.actions.addProduct}
          </button>
        </div>

        <div className="section">
          <h3>{t.sections.operations}</h3>
          <div className="ops-list">
            <div className="op-row" onClick={() => setOp('quota')}>
              <div><strong>{t.actions.changeQuota}</strong>
                <div className="desc">{lang === 'ru' ? 'Изменить лимит литров или денежный лимит' : 'Adjust the litres or money limit'}</div>
              </div><Icon name="chevron" size={14} />
            </div>
            <div className="op-row" onClick={() => setOp('period')}>
              <div><strong>{t.actions.changePeriod}</strong>
                <div className="desc">{lang === 'ru' ? 'Сдвинуть даты начала и окончания' : 'Shift the start and end dates'}</div>
              </div><Icon name="chevron" size={14} />
            </div>
            <div className="op-row" onClick={() => { setNewProd(availableProds[0]?.sku || ''); setOp('product'); }}>
              <div><strong>{t.actions.addProduct}</strong>
                <div className="desc">{lang === 'ru' ? 'Расширить ассортимент SKU' : 'Extend the SKU list'}</div>
              </div><Icon name="chevron" size={14} />
            </div>
            <div className="op-row" onClick={() => { setNewSP(availableSPs[0]?.id || ''); setOp('salepoint'); }}>
              <div><strong>{t.actions.addSalePoint}</strong>
                <div className="desc">{lang === 'ru' ? 'Добавить точку партнёра в охват' : 'Add another partner location to the scope'}</div>
              </div><Icon name="chevron" size={14} />
            </div>
            <div className="op-row" onClick={() => setOp('email')}>
              <div><strong>{t.actions.viewEmail}</strong>
                <div className="desc">{lang === 'ru' ? 'Открыть письмо Outlook для партнёра' : 'Re-open the Outlook notification email'}</div>
              </div><Icon name="mail" size={14} />
            </div>
            <div className="op-row" onClick={() => setOp('cancel')} style={{ borderColor: 'var(--bad-border)', background: 'var(--bad-bg)' }}>
              <div><strong style={{ color: 'var(--bad-fg)' }}>{t.actions.cancelPromo}</strong>
                <div className="desc">{lang === 'ru' ? 'Отменить акцию для партнёра и оповестить' : 'Cancel for partner and notify by email'}</div>
              </div><Icon name="trash" size={14} />
            </div>
          </div>
        </div>

        <div className="section">
          <h3>{t.sections.activity}</h3>
          <div className="timeline">
            <div className="tl-item"><div><strong>{lang === 'ru' ? 'Создано' : 'Created'}</strong><div className="when">{fmtDate(promo.createdAt, lang)} · {promo.createdBy}</div></div></div>
            {promo.emailSent && <div className="tl-item"><div><strong>{lang === 'ru' ? 'Письмо отправлено' : 'Notification email sent'}</strong><div className="when">{fmtDate(promo.createdAt, lang)} · Outlook</div></div></div>}
            {promo.usedLitres > 0 && <div className="tl-item"><div><strong>{lang === 'ru' ? 'Заявка обработана' : 'Partner request processed'}</strong><div className="when">{fmtDate(promo.startDate, lang)}</div></div></div>}
            {promo.cancelReason && <div className="tl-item"><div><strong>{lang === 'ru' ? 'Отмена' : 'Cancelled'}</strong><div className="when">{promo.cancelReason}</div></div></div>}
          </div>
        </div>
      </div>

      {/* Operation overlay */}
      {op && (
        <div style={{ position: 'absolute', inset: 0, background: 'rgba(15,23,42,.34)', display: 'flex', justifyContent: 'center', alignItems: 'center', padding: 24, zIndex: 5 }}>
          <div className="section" style={{ width: 480, maxWidth: '100%', margin: 0, boxShadow: 'var(--shadow-lg)' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 14 }}>
              <h3 style={{ margin: 0 }}>{({
                cancel: t.actions.cancelPromo, quota: t.actions.changeQuota, period: t.actions.changePeriod,
                product: t.actions.addProduct, salepoint: t.actions.addSalePoint, email: t.actions.viewEmail,
              })[op]}</h3>
              <button className="icon-btn" onClick={() => setOp(null)}><Icon name="close" /></button>
            </div>
            {op === 'quota' && (
              <div className="field">
                <label>{promo.type === 'nplus1' ? t.fields.quotaLitres : t.fields.quotaMoney}</label>
                <input className="input" type="number" value={quotaInput} onChange={(e) => setQuotaInput(e.target.value)} />
                <div className="hint">{lang === 'ru' ? 'Текущая' : 'Current'}: {promo.type === 'nplus1' ? fmtLitres(promo.quotaLitres) : fmtMoney(promo.quotaMoney)} · {lang === 'ru' ? 'использовано' : 'used'} {usagePct}%</div>
              </div>
            )}
            {op === 'period' && (
              <div className="row-2">
                <div className="field"><label>{t.fields.startDate}</label><input className="input" type="date" value={period.start} onChange={(e) => setPeriod({ ...period, start: e.target.value })} /></div>
                <div className="field"><label>{t.fields.endDate}</label><input className="input" type="date" value={period.end} onChange={(e) => setPeriod({ ...period, end: e.target.value })} /></div>
              </div>
            )}
            {op === 'product' && (
              <div className="field"><label>SKU</label>
                <select className="select" value={newProd} onChange={(e) => setNewProd(e.target.value)}>
                  {availableProds.map((p) => <option key={p.sku} value={p.sku}>{p.sku} — {p.name}</option>)}
                </select>
              </div>
            )}
            {op === 'salepoint' && (
              <div className="field"><label>{t.fields.salePoint}</label>
                <select className="select" value={newSP} onChange={(e) => setNewSP(e.target.value)}>
                  {availableSPs.map((s) => <option key={s.id} value={s.id}>{s.name} — {s.address}</option>)}
                </select>
              </div>
            )}
            {op === 'cancel' && (
              <div className="field"><label>{lang === 'ru' ? 'Причина отмены' : 'Reason for cancellation'}</label>
                <textarea className="textarea" value={cancelReason} onChange={(e) => setCancelReason(e.target.value)} placeholder={lang === 'ru' ? 'Кратко опишите причину…' : 'Briefly describe the reason…'} />
                <div className="hint">{lang === 'ru' ? 'Партнёру будет отправлено письмо с уведомлением.' : 'A cancellation email will be sent to the partner via Outlook.'}</div>
              </div>
            )}
            {op === 'email' && (
              <div className="email">
                <div className="email-head">
                  <span className="lk">{t.fields.recipient}</span><span className="vl">{partner?.name.toLowerCase().replace(/[^a-z]/g,'')}@partner.com</span>
                  <span className="lk">{t.fields.subject}</span><span className="vl"><strong>Promo-activity {promo.code} — {partner?.name}</strong></span>
                </div>
                <div className="email-body">{(t.placeholders.emailBody)
                  .replace('{code}', promo.code)
                  .replace('{start}', fmtDate(promo.startDate, lang))
                  .replace('{end}', fmtDate(promo.endDate, lang))
                  .replace('{type}', ACTIVITY_TYPES.find((a) => a.id === promo.type)['label_' + lang])
                  .replace('{products}', productObjs.map((p) => p.name).join(', '))
                  .replace('{quota}', promo.type === 'nplus1' ? fmtLitres(promo.quotaLitres) : fmtMoney(promo.quotaMoney))}
                </div>
              </div>
            )}
            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8, marginTop: 14 }}>
              <button className="btn" onClick={() => setOp(null)}>{t.actions.cancel}</button>
              {op !== 'email' && (
                <button className={cls('btn', op === 'cancel' ? 'danger' : 'primary')} onClick={submitOp}>
                  {op === 'cancel' ? t.actions.cancelPromo : t.actions.save}
                </button>
              )}
            </div>
          </div>
        </div>
      )}
    </>
  );
}

window.PromoDetail = PromoDetail;
</script>
<script type="text/babel" data-presets="react">
/* global React, PARTNERS, PRODUCTS, REQUESTS, Icon, Badge, Checkbox, cls,
   fmtNum, fmtMoney, fmtLitres, fmtDate, aiBadgeKind, aiIcon */
const { useState: useStateR, useMemo: useMemoR } = React;

function RequestsPanel({ t, lang, requests, setRequests, aiVariant, pushToast }) {
  const [selectedId, setSelectedId] = useStateR(requests[0]?.id || null);
  const sel = requests.find((r) => r.id === selectedId) || requests[0];

  const partner = PARTNERS.find((p) => p.id === sel?.partnerId);

  const setDecision = (id, decision) => {
    setRequests(requests.map((r) => r.id === id ? { ...r, decision } : r));
    pushToast(decision === 'approved' ? (lang === 'ru' ? 'Заявка одобрена' : 'Request approved') : (lang === 'ru' ? 'Заявка отклонена' : 'Request rejected'));
  };

  const renderAIBlock = (r) => {
    if (!r) return null;
    const notes = r['aiNotes_' + lang];
    const conf = Math.round(r.aiConfidence * 100);
    if (aiVariant === 'badges') {
      return (
        <div className="ai-card">
          <div className="ai-head">
            <Badge kind={aiBadgeKind(r.aiStatus)} dot>
              <Icon name={aiIcon(r.aiStatus)} size={11} strokeWidth={2.5} />{t.status[r.aiStatus]}
            </Badge>
            <strong>{lang === 'ru' ? 'Проверка AI' : 'AI verification'}</strong>
            <span className="conf">{t.misc.confidence} <span className="conf-bar"><span style={{ width: conf + '%' }} /></span> {conf}%</span>
          </div>
          <div className="ai-notes">{notes}</div>
        </div>
      );
    }
    if (aiVariant === 'diff') {
      // build diff: assume "system" volume = claimed × small jitter based on status
      const factor = r.aiStatus === 'verified' ? 1.001 : r.aiStatus === 'flag' ? 0.91 : 0.78;
      return (
        <div className="ai-card">
          <div className="ai-head">
            <Badge kind={aiBadgeKind(r.aiStatus)} dot>{t.status[r.aiStatus]}</Badge>
            <strong>{lang === 'ru' ? 'Сравнение с системой' : 'Side-by-side reconciliation'}</strong>
            <span className="conf">{t.misc.confidence} {conf}%</span>
          </div>
          <div className="ai-evidence">
            <div className="col">
              <h5>{lang === 'ru' ? 'Партнёр заявил' : 'Partner claim'}</h5>
              {r.claimedSales.map((s) => (
                <div className="diff-row" key={s.sku}>
                  <span>{s.sku}</span><span>{fmtLitres(s.litres)}</span>
                </div>
              ))}
            </div>
            <div className="col">
              <h5>{lang === 'ru' ? 'Найдено в Panorama' : 'Panorama / system'}</h5>
              {r.claimedSales.map((s) => {
                const sys = Math.round(s.litres * factor);
                const delta = ((s.litres - sys) / sys) * 100;
                const kind = Math.abs(delta) < 1 ? 'ok' : Math.abs(delta) < 8 ? 'warn' : 'bad';
                return (
                  <div className="diff-row" key={s.sku}>
                    <span>{fmtLitres(sys)}</span>
                    <span className={cls('delta', kind)}>{delta >= 0 ? '+' : ''}{delta.toFixed(1)}%</span>
                  </div>
                );
              })}
            </div>
          </div>
          <div className="ai-notes" style={{ marginTop: 10 }}>{notes}</div>
        </div>
      );
    }
    // chat
    return (
      <div className="ai-card">
        <div className="ai-head">
          <Badge kind={aiBadgeKind(r.aiStatus)} dot>{t.status[r.aiStatus]}</Badge>
          <strong>{lang === 'ru' ? 'AI-ассистент' : 'AI assistant'}</strong>
          <span className="conf">{conf}%</span>
        </div>
        <div className="ai-chat">
          <div className="ai-msg">
            <div className="av">AI</div>
            <div className="bubble">{lang === 'ru' ? 'Получил заявку. Проверяю объёмы и SKU…' : 'Got the request. Checking volumes and SKUs…'}</div>
          </div>
          <div className="ai-msg">
            <div className="av">AI</div>
            <div className="bubble">{notes}</div>
          </div>
          <div className="ai-msg">
            <div className="av">AI</div>
            <div className="bubble">
              {r.aiStatus === 'verified' && (lang === 'ru' ? 'Рекомендую одобрить.' : 'Recommendation: approve.')}
              {r.aiStatus === 'flag' && (lang === 'ru' ? 'Рекомендую ручную проверку перед одобрением.' : 'Recommendation: manual review before approving.')}
              {r.aiStatus === 'mismatch' && (lang === 'ru' ? 'Рекомендую отклонить или запросить сверку.' : 'Recommendation: reject or request reconciliation.')}
            </div>
          </div>
        </div>
      </div>
    );
  };

  return (
    <div style={{ display: 'grid', gridTemplateColumns: '420px 1fr', gap: 16, alignItems: 'flex-start' }}>
      <div className="section" style={{ padding: 0, overflow: 'hidden' }}>
        <div style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 8 }}>
          <strong style={{ fontSize: 13 }}>{t.nav.requests}</strong>
          <span className="badge" style={{ marginLeft: 'auto' }}>{requests.length}</span>
        </div>
        <div style={{ maxHeight: '70vh', overflowY: 'auto' }} className="scroll-hint">
          {requests.map((r) => {
            const p = PARTNERS.find((x) => x.id === r.partnerId);
            const total = r.claimedSales.reduce((acc, s) => acc + s.litres, 0);
            return (
              <div key={r.id}
                onClick={() => setSelectedId(r.id)}
                style={{
                  padding: '12px 14px',
                  borderBottom: '1px solid var(--border)',
                  background: sel?.id === r.id ? 'var(--brand-50)' : 'var(--surface)',
                  cursor: 'pointer',
                }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 4 }}>
                  <span className="code-tag">{r.promoCode}</span>
                  <Badge kind={aiBadgeKind(r.aiStatus)} dot>{t.status[r.aiStatus]}</Badge>
                </div>
                <div style={{ fontSize: 13, fontWeight: 600 }}>{p?.name}</div>
                <div style={{ fontSize: 12, color: 'var(--text-3)' }}>
                  {fmtDate(r.period.from, lang)} → {fmtDate(r.period.to, lang)} · {fmtLitres(total)}
                </div>
                {r.decision && (
                  <div style={{ marginTop: 4 }}>
                    <Badge kind={r.decision === 'approved' ? 'ok' : 'bad'}>
                      {r.decision === 'approved' ? (lang === 'ru' ? 'Одобрено' : 'Approved') : (lang === 'ru' ? 'Отклонено' : 'Rejected')}
                    </Badge>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <div>
        {sel && (
          <>
            <div className="section">
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: 8 }}>
                <div>
                  <div style={{ display: 'flex', gap: 8, alignItems: 'center', marginBottom: 4 }}>
                    <span className="code-tag">{sel.promoCode}</span>
                    <Badge kind={aiBadgeKind(sel.aiStatus)} dot>{t.status[sel.aiStatus]}</Badge>
                  </div>
                  <h3 style={{ margin: 0, fontSize: 16, textTransform: 'none', letterSpacing: 0 }}>{partner?.name}</h3>
                  <div style={{ fontSize: 12, color: 'var(--text-3)' }}>
                    {lang === 'ru' ? 'Заявка от' : 'Submitted'} {fmtDate(sel.submittedAt, lang)} · {lang === 'ru' ? 'период' : 'period'} {fmtDate(sel.period.from, lang)} → {fmtDate(sel.period.to, lang)}
                  </div>
                </div>
                <div style={{ display: 'flex', gap: 8 }}>
                  <button className="btn"><Icon name="refresh" size={14} />{t.misc.verifyAgain}</button>
                  <button className="btn"><Icon name="excel" size={14} />{t.actions.export}</button>
                </div>
              </div>
            </div>

            <div className="section">
              <h3>{t.sections.aiAssessment}</h3>
              {renderAIBlock(sel)}
            </div>

            <div className="section">
              <h3>{t.sections.claimedSales}</h3>
              <div className="table-wrap" style={{ borderRadius: 10 }}>
                <table className="data">
                  <thead>
                    <tr>
                      <th>SKU</th>
                      <th>{lang === 'ru' ? 'Продукт' : 'Product'}</th>
                      <th style={{ textAlign: 'right' }}>{lang === 'ru' ? 'Литров' : 'Litres'}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {sel.claimedSales.map((s) => {
                      const p = PRODUCTS.find((x) => x.sku === s.sku);
                      return (
                        <tr key={s.sku}>
                          <td className="cell-num">{s.sku}</td>
                          <td>{p?.name}</td>
                          <td className="cell-num" style={{ textAlign: 'right' }}>{fmtLitres(s.litres)}</td>
                        </tr>
                      );
                    })}
                    <tr style={{ background: 'var(--surface-2)' }}>
                      <td colSpan="2" style={{ fontWeight: 600 }}>{lang === 'ru' ? 'Итого' : 'Total'}</td>
                      <td className="cell-num" style={{ textAlign: 'right', fontWeight: 600 }}>
                        {fmtLitres(sel.claimedSales.reduce((a, s) => a + s.litres, 0))}
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div style={{ display: 'flex', gap: 8, justifyContent: 'flex-end' }}>
              <button className="btn"><Icon name="refresh" size={14} />{t.actions.reconcile}</button>
              <button className="btn danger" onClick={() => setDecision(sel.id, 'rejected')} disabled={sel.decision === 'rejected'}>
                <Icon name="close" size={14} />{t.actions.reject}
              </button>
              <button className="btn primary" onClick={() => setDecision(sel.id, 'approved')} disabled={sel.decision === 'approved'}>
                <Icon name="check" size={14} />{t.actions.approve}
              </button>
            </div>
          </>
        )}
      </div>
    </div>
  );
}

window.RequestsPanel = RequestsPanel;
</script>
<script type="text/babel" data-presets="react">
/* global React, ReactDOM, I18N, PROMOS, PARTNERS, REQUESTS, PRODUCTS, ACTIVITY_TYPES, ReactTable,
   Icon, Badge, StatusBadge, TypeBadge, Checkbox, Toast, cls,
   fmtNum, fmtMoney, fmtLitres, fmtDate, pct, statusBadgeKind, aiBadgeKind,
   TreePicker, CreatePromoForm, PromoDetail, RequestsPanel, findChannelLabel,
   TweaksPanel, useTweaks, TweakSection, TweakRadio, TweakToggle */
const { useState: useStateApp, useEffect: useEffectApp, useMemo: useMemoApp } = React;

const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
  "theme": "light",
  "createFlow": "wizard",
  "aiVariant": "badges"
}/*EDITMODE-END*/;

function App() {
  const [tweaks, setTweak] = useTweaks(TWEAK_DEFAULTS);
  const [lang, setLang] = useStateApp('ru');
  const [tab, setTab] = useStateApp('promos');
  const [promos, setPromos] = useStateApp(PROMOS);
  const [requests, setRequests] = useStateApp(REQUESTS);
  const [filter, setFilter] = useStateApp({ q: '' });
  const [creating, setCreating] = useStateApp(false);
  const [detailCode, setDetailCode] = useStateApp(null);
  const [toasts, setToasts] = useStateApp([]);

  useEffectApp(() => { document.documentElement.dataset.theme = tweaks.theme; }, [tweaks.theme]);

  const t = I18N[lang];

  const pushToast = (msg) => {
    const id = Math.random().toString(36).slice(2);
    setToasts((cur) => [...cur, { id, msg }]);
  };

  const detailPromo = promos.find((p) => p.code === detailCode);

  const stats = useMemoApp(() => {
    const active = promos.filter((p) => p.status === 'active');
    const litres = active.filter((p) => p.type === 'nplus1').reduce((a, p) => a + (p.quotaLitres || 0), 0);
    const money = active.filter((p) => p.type === 'money').reduce((a, p) => a + (p.quotaMoney || 0), 0);
    const pendingReq = requests.filter((r) => !r.decision).length;
    return { active: active.length, litres, money, pendingReq };
  }, [promos, requests]);

  const handleCreate = (newP) => {
    const code = newP.code;
    const stub = {
      code, type: 'nplus1', status: newP.status || 'draft',
      partnerId: 'p-001', salePointIds: ['sp-001'], channelIds: ['datum'],
      products: ['EFS-PIL-050'], nValue: 10, quotaLitres: 1000, usedLitres: 0,
      startDate: new Date().toISOString().slice(0,10),
      endDate: new Date(Date.now()+60*86400000).toISOString().slice(0,10),
      createdBy: 'You', createdAt: new Date().toISOString().slice(0,10),
      emailSent: !!newP.emailSent,
    };
    setPromos([stub, ...promos]);
    setCreating(false);
    pushToast(newP.emailSent
      ? (lang === 'ru' ? `Промо ${code} создано · письмо отправлено` : `Promo ${code} created · email sent`)
      : (lang === 'ru' ? `Черновик ${code} сохранён` : `Draft ${code} saved`));
  };

  const handlePatch = (patch) => {
    setPromos(promos.map((p) => p.code === detailCode ? { ...p, ...patch } : p));
  };

  return (
    <div className="app">
      {/* Sidebar */}
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-mark">EF</div>
          <div className="brand-text">
            <strong>Efes</strong>
            <span>{t.company}</span>
          </div>
        </div>

        <div className="nav-section-label">{lang === 'ru' ? 'Работа' : 'Workspace'}</div>
        <div className={cls('nav-item', tab === 'promos' && 'active')} onClick={() => setTab('promos')}>
          <Icon name="promo" />{t.nav.promos}
          <span className="nav-count">{promos.length}</span>
        </div>
        <div className={cls('nav-item', tab === 'requests' && 'active')} onClick={() => setTab('requests')}>
          <Icon name="requests" />{t.nav.requests}
          <span className="nav-count">{requests.filter((r) => !r.decision).length}</span>
        </div>

        <div className="nav-section-label">{lang === 'ru' ? 'Справочники' : 'Catalogue'}</div>
        <div className={cls('nav-item', tab === 'partners' && 'active')} onClick={() => setTab('partners')}>
          <Icon name="partners" />{t.nav.partners}<span className="nav-count">{PARTNERS.length}</span>
        </div>
        <div className={cls('nav-item', tab === 'products' && 'active')} onClick={() => setTab('products')}>
          <Icon name="products" />{t.nav.products}<span className="nav-count">{PRODUCTS.length}</span>
        </div>
        <div className="nav-item"><Icon name="reports" />{t.nav.reports}</div>
        <div className="nav-item"><Icon name="settings" />{t.nav.settings}</div>

        <div className="user-card">
          <div className="user-avatar">AV</div>
          <div className="user-meta">
            <strong>Aizhan Nurlanova</strong>
            <span>{lang === 'ru' ? 'Менеджер по продажам' : 'Sales manager'}</span>
          </div>
        </div>
      </aside>

      {/* Main */}
      <div className="main">
        <header className="topbar">
          <div className="crumbs">
            {t.appName} · <strong>{tab === 'requests' ? t.nav.requests : tab === 'partners' ? t.nav.partners : tab === 'products' ? t.nav.products : t.nav.promos}</strong>
          </div>
          <div className="search">
            <span className="search-icon"><Icon name="search" size={14} /></span>
            <input placeholder={t.actions.search} value={filter.q} onChange={(e) => setFilter({ ...filter, q: e.target.value })} />
            <span className="kbd">⌘K</span>
          </div>
          <div className="topbar-right">
            <div className="lang-toggle">
              <button className={lang === 'en' ? 'active' : ''} onClick={() => setLang('en')}>EN</button>
              <button className={lang === 'ru' ? 'active' : ''} onClick={() => setLang('ru')}>RU</button>
            </div>
            <button className="icon-btn" title={lang === 'ru' ? 'Уведомления' : 'Notifications'}>
              <Icon name="bell" size={14} />
            </button>
            <button className="icon-btn" onClick={() => setTweak('theme', tweaks.theme === 'light' ? 'dark' : 'light')}>
              <Icon name={tweaks.theme === 'light' ? 'moon' : 'sun'} size={14} />
            </button>
          </div>
        </header>

        <main className="page" data-screen-label={tab}>
          {tab === 'promos' && (
            <PromosView
              t={t} lang={lang} promos={promos} stats={stats} searchQuery={filter.q}
              onCreate={() => setCreating(true)}
              onSelect={(c) => setDetailCode(c)}
              pushToast={pushToast}
            />
          )}
          {tab === 'requests' && (
            <RequestsView t={t} lang={lang} requests={requests} setRequests={setRequests} aiVariant={tweaks.aiVariant} pushToast={pushToast} />
          )}
          {tab === 'partners' && <PartnersView t={t} lang={lang} promos={promos} />}
          {tab === 'products' && <ProductsView t={t} lang={lang} promos={promos} />}
        </main>
      </div>

      {creating && (
        <>
          <div className="drawer-mask" onClick={() => setCreating(false)} />
          <aside className={cls('drawer', tweaks.createFlow === 'panel' && 'wide')}>
            <CreatePromoForm
              t={t} lang={lang} layout={tweaks.createFlow === 'wizard' ? 'wizard' : 'panel'}
              onClose={() => setCreating(false)} onCreate={handleCreate}
            />
          </aside>
        </>
      )}

      {detailPromo && (
        <>
          <div className="drawer-mask" onClick={() => setDetailCode(null)} />
          <aside className="drawer wide" style={{ position: 'fixed' }}>
            <PromoDetail
              promo={detailPromo} t={t} lang={lang}
              onClose={() => setDetailCode(null)}
              onPatch={handlePatch}
              pushToast={pushToast}
            />
          </aside>
        </>
      )}

      <div className="toast-wrap">
        {toasts.map((tt) => <Toast key={tt.id} msg={tt.msg} onDone={() => setToasts((cur) => cur.filter((x) => x.id !== tt.id))} />)}
      </div>

      <TweaksPanel title="Tweaks">
        <TweakSection title={lang === 'ru' ? 'Тема' : 'Theme'}>
          <TweakRadio value={tweaks.theme} onChange={(v) => setTweak('theme', v)}
            options={[{ value: 'light', label: 'Light' }, { value: 'dark', label: 'Dark' }]} />
        </TweakSection>
        <TweakSection title={lang === 'ru' ? 'Создание промо' : 'Create-promo flow'}>
          <TweakRadio value={tweaks.createFlow} onChange={(v) => setTweak('createFlow', v)}
            options={[{ value: 'wizard', label: lang === 'ru' ? 'Мастер' : 'Wizard' }, { value: 'panel', label: lang === 'ru' ? 'Боковая панель' : 'Side panel' }]} />
        </TweakSection>
        <TweakSection title={lang === 'ru' ? 'Проверка AI' : 'AI verification'}>
          <TweakRadio value={tweaks.aiVariant} onChange={(v) => setTweak('aiVariant', v)}
            options={[
              { value: 'badges', label: lang === 'ru' ? 'Бейджи' : 'Badges' },
              { value: 'diff', label: 'Diff' },
              { value: 'chat', label: 'Chat' },
            ]} />
        </TweakSection>
      </TweaksPanel>
    </div>
  );
}

// ===== Promos =====
function PromosView({ t, lang, promos, stats, searchQuery, onCreate, onSelect, pushToast }) {
  return (
    <>
      <div className="page-title">
        <div>
          <h1>{t.nav.promos}</h1>
          <p>{lang === 'ru' ? 'Все промо-активности по партнёрам, точкам и каналам.' : 'All promo-activities across partners, sale points and channels.'}</p>
        </div>
        <div className="page-actions">
          <button className="btn" onClick={() => pushToast(lang === 'ru' ? 'Файл Excel сформирован' : 'Excel export generated')}>
            <Icon name="excel" size={14} />{t.actions.export}
          </button>
          <button className="btn primary" onClick={onCreate}><Icon name="plus" size={14} />{t.actions.newPromo}</button>
        </div>
      </div>

      <StatTiles stats={stats} t={t} lang={lang} />

      <PromoTable t={t} lang={lang} promos={promos} searchQuery={searchQuery} onSelect={onSelect} />
    </>
  );
}

const GROUP_NONE = 'none';

// Promo table powered by TanStack Table (window.ReactTable, UMD) — headless, so it keeps
// the existing design system while adding grouping, multi-column sorting and filtering.
function PromoTable({ t, lang, promos, searchQuery, onSelect }) {
  const {
    useReactTable, getCoreRowModel, getSortedRowModel, getFilteredRowModel,
    getGroupedRowModel, getExpandedRowModel, flexRender,
  } = window.ReactTable;

  const partnerOf = (p) => PARTNERS.find((x) => x.id === p.partnerId);

  const [sorting, setSorting] = useStateApp([]);
  const [grouping, setGrouping] = useStateApp(GROUP_NONE);
  const [expanded, setExpanded] = useStateApp(true);
  const [columnFilters, setColumnFilters] = useStateApp([]);

  const setColFilter = (id, val) => setColumnFilters((prev) => {
    const rest = prev.filter((f) => f.id !== id);
    return (val == null || val === 'all') ? rest : [...rest, { id, value: val }];
  });
  const colVal = (id) => { const f = columnFilters.find((x) => x.id === id); return f ? f.value : 'all'; };

  const columns = useMemoApp(() => [
    {
      id: 'code', header: t.fields.code, accessorFn: (p) => p.code, enableGrouping: false,
      cell: ({ row }) => <span className="code-tag">{row.original.code}</span>,
    },
    {
      id: 'partner', header: t.fields.partner, accessorFn: (p) => partnerOf(p)?.name || '',
      cell: ({ row }) => {
        const pt = partnerOf(row.original);
        return (
          <div className="cell-stack">
            <strong style={{ fontSize: 13 }}>{pt?.name}</strong>
            <span className="sub">{pt?.city} · {pt?.segment === 'ontrade' ? 'On trade' : 'Off trade'}</span>
          </div>
        );
      },
    },
    {
      id: 'type', header: t.fields.type, accessorFn: (p) => p.type, filterFn: 'equals',
      cell: ({ row }) => <TypeBadge type={row.original.type} t={t} />,
    },
    { id: 'segment', header: 'Segment', accessorFn: (p) => partnerOf(p)?.segment, filterFn: 'equals' },
    {
      id: 'channel', header: t.fields.channel,
      accessorFn: (p) => p.channelIds.map((c) => findChannelLabel(c, lang)).join(', '),
      filterFn: (row, id, val) => row.original.channelIds.includes(val),
    },
    { id: 'region', header: 'Region', accessorFn: (p) => partnerOf(p)?.city || '', filterFn: 'equals' },
    {
      id: 'scope', header: t.fields.scope, enableGrouping: false, accessorFn: (p) => p.salePointIds.length,
      cell: ({ row }) => {
        const p = row.original;
        return (
          <div className="cell-stack">
            <span style={{ fontSize: 12.5 }}>{p.salePointIds.length} {lang === 'ru' ? 'точек' : 'pts'}</span>
            <span className="sub">{p.channelIds.map((c) => findChannelLabel(c, lang)).join(', ')}</span>
          </div>
        );
      },
    },
    {
      id: 'products', header: t.fields.products, enableGrouping: false, accessorFn: (p) => p.products.length,
      cell: ({ getValue }) => <span>{getValue()} SKU</span>, meta: { tdClass: 'cell-num', tdStyle: { fontSize: 12 } },
    },
    {
      id: 'period', header: t.fields.period, enableGrouping: false, accessorFn: (p) => new Date(p.startDate).getTime(),
      cell: ({ row }) => {
        const p = row.original;
        return (
          <div className="cell-stack">
            <span>{fmtDate(p.startDate, lang)}</span>
            <span className="sub">{fmtDate(p.endDate, lang)}</span>
          </div>
        );
      },
      meta: { tdClass: 'cell-num', tdStyle: { fontSize: 12 } },
    },
    {
      id: 'utilisation', header: t.fields.progress, enableGrouping: false,
      accessorFn: (p) => pct(p.usedLitres, p.quotaLitres) || pct(p.usedMoney, p.quotaMoney),
      cell: ({ row }) => {
        const p = row.original;
        const u = pct(p.usedLitres, p.quotaLitres) || pct(p.usedMoney, p.quotaMoney);
        const k = u >= 95 ? 'bad' : u >= 75 ? 'warn' : '';
        const total = p.type === 'nplus1' ? fmtLitres(p.quotaLitres) : fmtMoney(p.quotaMoney);
        const used = p.type === 'nplus1' ? fmtLitres(p.usedLitres) : fmtMoney(p.usedMoney);
        return (
          <div className="cell-stack">
            <div className={cls('progress', k)}><span style={{ width: u + '%' }} /></div>
            <span className="sub cell-num" style={{ fontSize: 11.5 }}>{used} / {total}</span>
          </div>
        );
      },
    },
    {
      id: 'status', header: lang === 'ru' ? 'Статус' : 'Status', accessorFn: (p) => p.status, filterFn: 'equals',
      cell: ({ row }) => <StatusBadge status={row.original.status} t={t} />,
    },
    {
      id: 'owner', header: t.fields.createdBy, accessorFn: (p) => p.createdBy, filterFn: 'equals',
      cell: ({ getValue }) => <span style={{ fontSize: 12.5 }}>{getValue()}</span>,
    },
  ], [t, lang]);

  const globalFilterFn = (row, columnId, value) => {
    if (!value) return true;
    const q = String(value).toLowerCase();
    const p = row.original;
    const pt = partnerOf(p);
    return p.code.toLowerCase().includes(q)
      || (pt?.name || '').toLowerCase().includes(q)
      || (pt?.city || '').toLowerCase().includes(q)
      || (p.createdBy || '').toLowerCase().includes(q)
      || p.products.some((s) => s.toLowerCase().includes(q));
  };

  // Memoise derived state so refs stay stable across renders — passing a fresh []/{}
  // each render makes TanStack's change-detection/auto-reset churn (and can lock up).
  const groupingState = useMemoApp(() => (grouping === GROUP_NONE ? [] : [grouping]), [grouping]);
  const columnVisibility = useMemoApp(() => ({ segment: false, channel: false, region: false }), []);

  const table = useReactTable({
    data: promos,
    columns,
    state: { sorting, grouping: groupingState, expanded, columnFilters, globalFilter: searchQuery || '', columnVisibility },
    onSortingChange: setSorting,
    onExpandedChange: setExpanded,
    onColumnFiltersChange: setColumnFilters,
    globalFilterFn,
    getRowId: (p) => p.code,
    getCoreRowModel: getCoreRowModel(),
    getFilteredRowModel: getFilteredRowModel(),
    getGroupedRowModel: getGroupedRowModel(),
    getSortedRowModel: getSortedRowModel(),
    getExpandedRowModel: getExpandedRowModel(),
    autoResetExpanded: false,
    autoResetPageIndex: false,
    autoResetAll: false,
  });

  const visibleCols = table.getVisibleLeafColumns().length;
  const rows = table.getRowModel().rows;
  const filteredCount = table.getFilteredRowModel().rows.length;
  const groupCount = rows.filter((r) => r.getIsGrouped()).length;

  const groupLabels = {
    region: lang === 'ru' ? 'Регион' : 'Region',
    segment: lang === 'ru' ? 'Сегмент' : 'Segment', partner: t.fields.partner, type: t.fields.type,
    status: lang === 'ru' ? 'Статус' : 'Status', channel: t.fields.channel, owner: t.fields.createdBy,
  };
  const renderGroupValue = (colId, value) => {
    if (colId === 'segment') return <strong>{value === 'ontrade' ? 'On trade' : 'Off trade'}</strong>;
    if (colId === 'status') return <StatusBadge status={value} t={t} />;
    if (colId === 'type') return <TypeBadge type={value} t={t} />;
    return <strong>{value || '—'}</strong>;
  };
  const groupAggs = (leaves) => ({
    litres: leaves.filter((p) => p.type === 'nplus1').reduce((a, p) => a + (p.quotaLitres || 0), 0),
    money: leaves.filter((p) => p.type === 'money').reduce((a, p) => a + (p.quotaMoney || 0), 0),
  });

  const GROUP_OPTIONS = [
    { value: 'region', label: lang === 'ru' ? 'Регион' : 'Region' },
    { value: GROUP_NONE, label: lang === 'ru' ? 'Без группировки' : 'No grouping' },
    { value: 'segment', label: lang === 'ru' ? 'Сегмент' : 'Segment' },
    { value: 'partner', label: t.fields.partner },
    { value: 'type', label: t.fields.type },
    { value: 'status', label: lang === 'ru' ? 'Статус' : 'Status' },
    { value: 'channel', label: t.fields.channel },
    { value: 'owner', label: t.fields.createdBy },
  ];
  const STATUS_OPTS = [
    { value: 'all', label: lang === 'ru' ? 'Все' : 'All' },
    { value: 'active', label: t.status.active }, { value: 'pending', label: t.status.pending },
    { value: 'draft', label: t.status.draft }, { value: 'expired', label: t.status.expired },
    { value: 'cancelled', label: t.status.cancelled },
  ];
  const SEGMENT_OPTS = [
    { value: 'all', label: lang === 'ru' ? 'Все' : 'All' },
    { value: 'ontrade', label: 'On trade' }, { value: 'offtrade', label: 'Off trade' },
  ];
  const TYPE_OPTS = [
    { value: 'all', label: lang === 'ru' ? 'Все' : 'All' },
    { value: 'nplus1', label: 'N + 1' }, { value: 'money', label: 'N + KZT' },
  ];

  const owners = useMemoApp(() => [...new Set(promos.map((p) => p.createdBy))], [promos]);
  const channelIds = useMemoApp(() => {
    const ids = new Set();
    promos.forEach((p) => p.channelIds.forEach((c) => ids.add(c)));
    return [...ids];
  }, [promos]);
  const regions = useMemoApp(() => [...new Set(promos.map((p) => partnerOf(p)?.city).filter(Boolean))].sort(), [promos]);

  return (
    <>
      <div className="toolbar">
        <span className="group-by">
          <span className="tb-label">{lang === 'ru' ? 'Группировка' : 'Group by'}</span>
          <select className="select compact" value={grouping} onChange={(e) => setGrouping(e.target.value)}>
            {GROUP_OPTIONS.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}
          </select>
        </span>
        <span className="tb-div" />
        <FilterChips label={lang === 'ru' ? 'Статус' : 'Status'} value={colVal('status')} onChange={(v) => setColFilter('status', v)} options={STATUS_OPTS} />
        <span className="tb-div" />
        <FilterChips label={lang === 'ru' ? 'Сегмент' : 'Segment'} value={colVal('segment')} onChange={(v) => setColFilter('segment', v)} options={SEGMENT_OPTS} />
        <span className="tb-div" />
        <FilterChips label={t.fields.type} value={colVal('type')} onChange={(v) => setColFilter('type', v)} options={TYPE_OPTS} />
        <div className="toolbar-spacer" />
        <select className="select compact" value={colVal('region')} onChange={(e) => setColFilter('region', e.target.value)}>
          <option value="all">{lang === 'ru' ? 'Все регионы' : 'All regions'}</option>
          {regions.map((c) => <option key={c} value={c}>{c}</option>)}
        </select>
        <select className="select compact" value={colVal('channel')} onChange={(e) => setColFilter('channel', e.target.value)}>
          <option value="all">{lang === 'ru' ? 'Все каналы' : 'All channels'}</option>
          {channelIds.map((c) => <option key={c} value={c}>{findChannelLabel(c, lang)}</option>)}
        </select>
        <select className="select compact" value={colVal('owner')} onChange={(e) => setColFilter('owner', e.target.value)}>
          <option value="all">{lang === 'ru' ? 'Все ответственные' : 'All owners'}</option>
          {owners.map((o) => <option key={o} value={o}>{o}</option>)}
        </select>
      </div>

      <div className="toolbar toolbar-sub">
        {grouping !== GROUP_NONE && (
          <>
            <button className="btn sm ghost" onClick={() => setExpanded(true)}>{lang === 'ru' ? 'Развернуть всё' : 'Expand all'}</button>
            <button className="btn sm ghost" onClick={() => setExpanded({})}>{lang === 'ru' ? 'Свернуть всё' : 'Collapse all'}</button>
            <span className="tb-div" />
          </>
        )}
        {sorting.length > 0 && (
          <button className="btn sm ghost" onClick={() => setSorting([])}><Icon name="close" size={12} />{lang === 'ru' ? 'Сбросить сортировку' : 'Clear sort'}</button>
        )}
        {columnFilters.length > 0 && (
          <button className="btn sm ghost" onClick={() => setColumnFilters([])}><Icon name="close" size={12} />{lang === 'ru' ? 'Сбросить фильтры' : 'Clear filters'}</button>
        )}
        <div className="toolbar-spacer" />
        <span className="tb-hint">
          {filteredCount} {lang === 'ru' ? 'результатов' : 'results'}
          {grouping !== GROUP_NONE && <span> · {groupCount} {lang === 'ru' ? 'групп' : 'groups'}</span>}
          {sorting.length > 0 && <span> · {lang === 'ru' ? 'сортировка' : 'sorted'}: {sorting.map((s) => s.id).join(', ')}</span>}
        </span>
      </div>

      <div className="table-wrap">
        <table className="data">
          <thead>
            {table.getHeaderGroups().map((hg) => (
              <tr key={hg.id}>
                {hg.headers.map((header) => {
                  const canSort = header.column.getCanSort();
                  const sorted = header.column.getIsSorted();
                  return (
                    <th key={header.id} className={canSort ? 'sortable' : ''}
                      onClick={canSort ? header.column.getToggleSortingHandler() : undefined}
                      title={canSort ? (lang === 'ru' ? 'Нажмите для сортировки (Shift — мульти-сортировка)' : 'Click to sort (Shift for multi-sort)') : undefined}>
                      <span className="th-inner">
                        {flexRender(header.column.columnDef.header, header.getContext())}
                        {canSort && <span className={cls('sort-ind', sorted)}>{sorted === 'asc' ? '▲' : sorted === 'desc' ? '▼' : '↕'}</span>}
                      </span>
                    </th>
                  );
                })}
              </tr>
            ))}
          </thead>
          <tbody>
            {rows.map((row) => {
              if (row.getIsGrouped()) {
                const colId = row.groupingColumnId;
                const value = row.getValue(colId);
                const aggs = groupAggs(row.getLeafRows().map((r) => r.original));
                return (
                  <tr key={row.id} className="group-row" onClick={() => row.toggleExpanded()}>
                    <td colSpan={visibleCols}>
                      <div className="group-head">
                        <span className="group-twisty"><Icon name={row.getIsExpanded() ? 'chevronDown' : 'chevron'} size={14} /></span>
                        <span className="group-dim">{groupLabels[colId]}</span>
                        <span className="group-val">{renderGroupValue(colId, value)}</span>
                        <span className="badge">{row.subRows.length}</span>
                        <span className="group-aggs">
                          {aggs.litres > 0 && <span>{fmtLitres(aggs.litres)}</span>}
                          {aggs.money > 0 && <span>{fmtMoney(aggs.money)}</span>}
                        </span>
                      </div>
                    </td>
                  </tr>
                );
              }
              return (
                <tr key={row.id} onClick={() => onSelect(row.original.code)}>
                  {row.getVisibleCells().map((cell) => {
                    const meta = cell.column.columnDef.meta || {};
                    const indent = grouping !== GROUP_NONE && cell.column.id === 'code';
                    return (
                      <td key={cell.id} className={meta.tdClass || ''}
                        style={{ ...(meta.tdStyle || {}), ...(indent ? { paddingLeft: 30 } : {}) }}>
                        {flexRender(cell.column.columnDef.cell, cell.getContext())}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
        </table>
        {filteredCount === 0 && <div className="empty">{t.misc.noResults}</div>}
      </div>
    </>
  );
}

function FilterChips({ label, value, onChange, options }) {
  return (
    <>
      <span style={{ fontSize: 11.5, color: 'var(--text-3)', marginRight: 4, textTransform: 'uppercase', letterSpacing: '.04em', fontWeight: 600 }}>{label}</span>
      {options.map((o) => (
        <button key={o.value} className={cls('chip', value === o.value && 'active')} onClick={() => onChange(o.value)}>
          {o.label}
        </button>
      ))}
    </>
  );
}

function StatTiles({ stats, t, lang }) {
  return (
    <div className="stats">
      <div className="stat">
        <span className="stat-label">{t.summary.totalActive}</span>
        <span className="stat-value">{stats.active}</span>
        <span className="stat-sub"><b>+3</b> {lang === 'ru' ? 'за неделю' : 'this week'}</span>
      </div>
      <div className="stat">
        <span className="stat-label">{t.summary.totalLitres}</span>
        <span className="stat-value">{fmtNum(stats.litres)}<span style={{ fontSize: 14, color: 'var(--text-3)', marginLeft: 4 }}>L</span></span>
        <span className="stat-sub">{lang === 'ru' ? 'по активным N + 1' : 'across active N + 1 promos'}</span>
      </div>
      <div className="stat">
        <span className="stat-label">{t.summary.totalMoney}</span>
        <span className="stat-value">₸{(stats.money / 1000000).toFixed(2)}M</span>
        <span className="stat-sub">{lang === 'ru' ? 'по денежным акциям' : 'across N + KZT'}</span>
      </div>
      <div className="stat">
        <span className="stat-label">{t.summary.pendingRequests}</span>
        <span className="stat-value">{stats.pendingReq}</span>
        <span className="stat-sub">{lang === 'ru' ? 'ожидают решения' : 'waiting for decision'}</span>
      </div>
    </div>
  );
}

// ===== Requests =====
function RequestsView({ t, lang, requests, setRequests, aiVariant, pushToast }) {
  return (
    <>
      <div className="page-title">
        <div>
          <h1>{t.nav.requests}</h1>
          <p>{lang === 'ru' ? 'Заявки от партнёров на компенсации с автоматической AI-сверкой.' : 'Partner compensation requests with automatic AI cross-check.'}</p>
        </div>
        <div className="page-actions">
          <button className="btn"><Icon name="excel" size={14} />{t.actions.export}</button>
        </div>
      </div>
      <RequestsPanel t={t} lang={lang} requests={requests} setRequests={setRequests} aiVariant={aiVariant} pushToast={pushToast} />
    </>
  );
}

// ===== Partners =====
function PartnersView({ t, lang, promos }) {
  return (
    <>
      <div className="page-title"><div><h1>{t.nav.partners}</h1><p>{lang === 'ru' ? 'Иерархия партнёров, точек продаж и каналов.' : 'Partner hierarchy with sale points and channels.'}</p></div></div>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: 12 }}>
        {PARTNERS.map((p) => {
          const cnt = promos.filter((pp) => pp.partnerId === p.id).length;
          return (
            <div key={p.id} className="section" style={{ marginBottom: 0 }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                <div>
                  <span className="code-tag" style={{ fontSize: 11 }}>{p.code}</span>
                  <h3 style={{ margin: '6px 0 2px', textTransform: 'none', letterSpacing: 0, fontSize: 16 }}>{p.name}</h3>
                  <div style={{ fontSize: 12, color: 'var(--text-3)' }}>{p.city}</div>
                </div>
                <Badge kind={p.segment === 'ontrade' ? 'info' : ''}>{p.segment === 'ontrade' ? 'On trade' : 'Off trade'}</Badge>
              </div>
              <div style={{ marginTop: 12, display: 'grid', gap: 6 }}>
                {p.salePoints.map((s) => (
                  <div key={s.id} style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 8px', borderTop: '1px solid var(--border)', fontSize: 12.5 }}>
                    <span><Icon name="package" size={12} /> {s.name}<span style={{ color: 'var(--text-3)' }}> · {s.address}</span></span>
                    <span style={{ color: 'var(--text-3)', fontSize: 11 }}>{findChannelLabel(s.channel, lang)}</span>
                  </div>
                ))}
              </div>
              <div style={{ marginTop: 10, fontSize: 11.5, color: 'var(--text-3)' }}>
                {cnt} {lang === 'ru' ? 'промо-активностей' : 'promo-activities'}
              </div>
            </div>
          );
        })}
      </div>
    </>
  );
}

// ===== Products =====
function ProductsView({ t, lang, promos }) {
  return (
    <>
      <div className="page-title"><div><h1>{t.nav.products}</h1><p>{lang === 'ru' ? 'Каталог продуктов Efes, доступных для промо.' : 'Product catalogue eligible for promo activities.'}</p></div></div>
      <div className="table-wrap">
        <table className="data">
          <thead><tr><th>SKU</th><th>{lang === 'ru' ? 'Продукт' : 'Product'}</th><th>{lang === 'ru' ? 'Объём' : 'Volume'}</th><th>{lang === 'ru' ? 'Активных промо' : 'In active promos'}</th></tr></thead>
          <tbody>
            {PRODUCTS.map((p) => {
              const cnt = promos.filter((pp) => pp.products.includes(p.sku) && pp.status === 'active').length;
              return (
                <tr key={p.sku}>
                  <td><span className="code-tag">{p.sku}</span></td>
                  <td>{p.name}</td>
                  <td className="cell-num">{p.volume} L</td>
                  <td><Badge>{cnt}</Badge></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body></html>
