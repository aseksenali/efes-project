      <bpmndi:BPMNShape id="End_PRT_di" bpmnElement="End_PRT">
        <dc:Bounds x="1492" y="782" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1480" y="823" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_SameContent_di" bpmnElement="Note_SameContent">
        <dc:Bounds x="260" y="85" width="240" height="70" />
