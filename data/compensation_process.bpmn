<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Compensation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_Compensation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_CRM" name="CRM support specialist">
        <bpmn:flowNodeRef>Task_CRM_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SFE" name="SFE specialist">
        <bpmn:flowNodeRef>Task_SFE_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Partner" name="Partner" />
      <bpmn:lane id="Lane_SSC" name="Sales systems communication specialist">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split_Inputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SSC_RecvOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SSC_RecvTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitVedomost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_25th</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemindPartner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RemindPartner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split_Vedomost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join_OpInputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join_TechInputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_OpsPreApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToOperators</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitOpApprovals</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_3d_Op</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemindOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RemindOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsolidateOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOpToSCtrl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitSCtrlOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ErrorsOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixErrorsOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Op</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitSSupTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_3d_SSupTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemindSSupTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RemindSSupTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsolidateTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTechToSCtrl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitSCtrlTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ErrorsTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixErrorsTech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Tech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendTechToSup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Op" name="Operator">
        <bpmn:flowNodeRef>Task_OperatorApprove</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SSup" name="Sales supervisor">
        <bpmn:flowNodeRef>Task_SSupApproveTech</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCtrl" name="Sales controlling">
        <bpmn:flowNodeRef>Task_SCtrlApproveOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SCtrlApproveTech</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Monthly compensation&#10;cycle begins">
      <bpmn:outgoing>Flow_Start_to_Split</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Start_1" />
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gw_Split_Inputs">
      <bpmn:incoming>Flow_Start_to_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_to_CRM</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_to_SFE</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_to_Wait</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_CRM_Send" name="Send Excel of operator&#10;compensation calculations">
      <bpmn:incoming>Flow_Split_to_CRM</bpmn:incoming>
      <bpmn:outgoing>Flow_CRM_to_Recv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_SSC_RecvOp" name="Receive operator&#10;compensation Excel">
      <bpmn:incoming>Flow_CRM_to_Recv</bpmn:incoming>
      <bpmn:outgoing>Flow_RecvOp_to_Join</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_SFE_Send" name="Send Excel of technician&#10;compensation calculations">
      <bpmn:incoming>Flow_Split_to_SFE</bpmn:incoming>
      <bpmn:outgoing>Flow_SFE_to_Recv</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_SSC_RecvTech" name="Receive technician&#10;compensation Excel">
      <bpmn:incoming>Flow_SFE_to_Recv</bpmn:incoming>
      <bpmn:outgoing>Flow_RecvTech_to_Join</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Task_WaitVedomost" name="Wait for «Ведомость о&#10;поощрении сотрудников»&#10;from all Partners">
      <bpmn:incoming>Flow_Split_to_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_to_VedSplit</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_25th" name="25th of month" cancelActivity="false" attachedToRef="Task_WaitVedomost">
      <bpmn:outgoing>Flow_Bnd25_to_Remind</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Bnd_25th" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_RemindPartner" name="Remind Partner —&#10;«Ведомость» due 25th">
      <bpmn:incoming>Flow_Bnd25_to_Remind</bpmn:incoming>
      <bpmn:outgoing>Flow_RemindPart_to_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RemindPartner" name="Partner reminded">
      <bpmn:incoming>Flow_RemindPart_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gw_Split_Vedomost">
      <bpmn:incoming>Flow_Wait_to_VedSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_VedSplit_to_OpJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_VedSplit_to_TechJoin</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gw_Join_OpInputs">
      <bpmn:incoming>Flow_RecvOp_to_Join</bpmn:incoming>
      <bpmn:incoming>Flow_VedSplit_to_OpJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_OpJoin_to_PreGw</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gw_Join_TechInputs">
      <bpmn:incoming>Flow_RecvTech_to_Join</bpmn:incoming>
      <bpmn:incoming>Flow_VedSplit_to_TechJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_TechJoin_to_Send</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gw_OpsPreApproved" name="Operator&#10;pre-approved&#10;by Partner?">
      <bpmn:incoming>Flow_OpJoin_to_PreGw</bpmn:incoming>
      <bpmn:outgoing>Flow_OpsPre_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_OpsPre_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendToOperators" name="Send «Ведомость» to&#10;each Operator&#10;(operator records only)">
      <bpmn:incoming>Flow_OpsPre_No</bpmn:incoming>
      <bpmn:outgoing>Flow_SendOp_to_OpApprove</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:sendTask>
    <bpmn:userTask id="Task_OperatorApprove" name="Approve «Ведомость»">
      <bpmn:incoming>Flow_SendOp_to_OpApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_OpApprove_to_Wait</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:userTask>
    <bpmn:receiveTask id="Task_WaitOpApprovals" name="Wait for approvals from&#10;all Operators">
      <bpmn:incoming>Flow_OpApprove_to_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitOpAppr_to_Cons</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_3d_Op" name="3 days elapsed" cancelActivity="false" attachedToRef="Task_WaitOpApprovals">
      <bpmn:outgoing>Flow_Bnd3dOp_to_Remind</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Bnd_3d_Op" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_RemindOp" name="Send reminder&#10;to Operator">
      <bpmn:incoming>Flow_Bnd3dOp_to_Remind</bpmn:incoming>
      <bpmn:outgoing>Flow_RemindOp_to_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RemindOp" name="Operator reminded">
      <bpmn:incoming>Flow_RemindOp_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ConsolidateOp" name="Consolidate operator file:&#10;totals by Operator">
      <bpmn:incoming>Flow_OpsPre_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_WaitOpAppr_to_Cons</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsOp_to_Send</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_SendOpToSCtrl" name="Send operator consolidated&#10;file to Sales controlling">
      <bpmn:incoming>Flow_ConsOp_to_Send</bpmn:incoming>
      <bpmn:incoming>Flow_FixOp_to_SendSCtrl</bpmn:incoming>
      <bpmn:outgoing>Flow_SendOpSCtrl_to_App</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_SCtrlApproveOp" name="Review operator file &#38;&#10;approve / report errors">
      <bpmn:incoming>Flow_SendOpSCtrl_to_App</bpmn:incoming>
      <bpmn:outgoing>Flow_SCtrlOp_to_Wait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Task_WaitSCtrlOp" name="Wait for Sales controlling&#10;response (operator file)">
      <bpmn:incoming>Flow_SCtrlOp_to_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitSCtrlOp_to_Gw</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gw_ErrorsOp" name="Errors&#10;reported?">
      <bpmn:incoming>Flow_WaitSCtrlOp_to_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrOp_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ErrOp_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FixErrorsOp" name="Fix errors in&#10;operator file">
      <bpmn:incoming>Flow_ErrOp_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_FixOp_to_SendSCtrl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Op" name="Operator cycle&#10;completed">
      <bpmn:incoming>Flow_ErrOp_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendTechToSup" name="Send technician file&#10;to Sales supervisor">
      <bpmn:incoming>Flow_TechJoin_to_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_SendTech_to_App</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_SSupApproveTech" name="Approve technician&#10;«Ведомость»">
      <bpmn:incoming>Flow_SendTech_to_App</bpmn:incoming>
      <bpmn:outgoing>Flow_SSupTech_to_Wait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Task_WaitSSupTech" name="Wait for Sales supervisor&#10;approval (technician file)">
      <bpmn:incoming>Flow_SSupTech_to_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitSSupTech_Cons</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_3d_SSupTech" name="3 days elapsed" cancelActivity="false" attachedToRef="Task_WaitSSupTech">
      <bpmn:outgoing>Flow_Bnd3dSSupTech_Rem</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Bnd_3d_SSupTech" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_RemindSSupTech" name="Remind Sales supervisor&#10;(technician file)">
      <bpmn:incoming>Flow_Bnd3dSSupTech_Rem</bpmn:incoming>
      <bpmn:outgoing>Flow_RemindSSupTech_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RemindSSupTech" name="Supervisor reminded">
      <bpmn:incoming>Flow_RemindSSupTech_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ConsolidateTech" name="Consolidate technician file:&#10;totals by Partner">
      <bpmn:incoming>Flow_WaitSSupTech_Cons</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsTech_to_Send</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_SendTechToSCtrl" name="Send technician consolidated&#10;file to Sales controlling">
      <bpmn:incoming>Flow_ConsTech_to_Send</bpmn:incoming>
      <bpmn:incoming>Flow_FixTech_SendSCtrl</bpmn:incoming>
      <bpmn:outgoing>Flow_SendTechSCtrl_App</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_SCtrlApproveTech" name="Review technician file &#38;&#10;approve / report errors">
      <bpmn:incoming>Flow_SendTechSCtrl_App</bpmn:incoming>
      <bpmn:outgoing>Flow_SCtrlTech_to_Wait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="Task_WaitSCtrlTech" name="Wait for Sales controlling&#10;response (technician file)">
      <bpmn:incoming>Flow_SCtrlTech_to_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitSCtrlTech_Gw</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gw_ErrorsTech" name="Errors&#10;reported?">
      <bpmn:incoming>Flow_WaitSCtrlTech_Gw</bpmn:incoming>
      <bpmn:outgoing>Flow_ErrTech_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ErrTech_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FixErrorsTech" name="Fix errors in&#10;technician file">
      <bpmn:incoming>Flow_ErrTech_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_FixTech_SendSCtrl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Tech" name="Technician cycle&#10;completed">
      <bpmn:incoming>Flow_ErrTech_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_to_Split" sourceRef="Start_1" targetRef="Gw_Split_Inputs" />
    <bpmn:sequenceFlow id="Flow_Split_to_CRM" sourceRef="Gw_Split_Inputs" targetRef="Task_CRM_Send" />
    <bpmn:sequenceFlow id="Flow_Split_to_SFE" sourceRef="Gw_Split_Inputs" targetRef="Task_SFE_Send" />
    <bpmn:sequenceFlow id="Flow_Split_to_Wait" sourceRef="Gw_Split_Inputs" targetRef="Task_WaitVedomost" />
    <bpmn:sequenceFlow id="Flow_CRM_to_Recv" sourceRef="Task_CRM_Send" targetRef="Task_SSC_RecvOp" />
    <bpmn:sequenceFlow id="Flow_RecvOp_to_Join" sourceRef="Task_SSC_RecvOp" targetRef="Gw_Join_OpInputs" />
    <bpmn:sequenceFlow id="Flow_SFE_to_Recv" sourceRef="Task_SFE_Send" targetRef="Task_SSC_RecvTech" />
    <bpmn:sequenceFlow id="Flow_RecvTech_to_Join" sourceRef="Task_SSC_RecvTech" targetRef="Gw_Join_TechInputs" />
    <bpmn:sequenceFlow id="Flow_Wait_to_VedSplit" sourceRef="Task_WaitVedomost" targetRef="Gw_Split_Vedomost" />
    <bpmn:sequenceFlow id="Flow_VedSplit_to_OpJoin" sourceRef="Gw_Split_Vedomost" targetRef="Gw_Join_OpInputs" />
    <bpmn:sequenceFlow id="Flow_VedSplit_to_TechJoin" sourceRef="Gw_Split_Vedomost" targetRef="Gw_Join_TechInputs" />
    <bpmn:sequenceFlow id="Flow_Bnd25_to_Remind" sourceRef="Bnd_25th" targetRef="Task_RemindPartner" />
    <bpmn:sequenceFlow id="Flow_RemindPart_to_End" sourceRef="Task_RemindPartner" targetRef="End_RemindPartner" />
    <bpmn:sequenceFlow id="Flow_OpJoin_to_PreGw" sourceRef="Gw_Join_OpInputs" targetRef="Gw_OpsPreApproved" />
    <bpmn:sequenceFlow id="Flow_OpsPre_No" name="No" sourceRef="Gw_OpsPreApproved" targetRef="Task_SendToOperators" />
    <bpmn:sequenceFlow id="Flow_OpsPre_Yes" name="Yes" sourceRef="Gw_OpsPreApproved" targetRef="Task_ConsolidateOp" />
    <bpmn:sequenceFlow id="Flow_SendOp_to_OpApprove" sourceRef="Task_SendToOperators" targetRef="Task_OperatorApprove" />
    <bpmn:sequenceFlow id="Flow_OpApprove_to_Wait" sourceRef="Task_OperatorApprove" targetRef="Task_WaitOpApprovals" />
    <bpmn:sequenceFlow id="Flow_Bnd3dOp_to_Remind" sourceRef="Bnd_3d_Op" targetRef="Task_RemindOp" />
    <bpmn:sequenceFlow id="Flow_RemindOp_to_End" sourceRef="Task_RemindOp" targetRef="End_RemindOp" />
    <bpmn:sequenceFlow id="Flow_WaitOpAppr_to_Cons" sourceRef="Task_WaitOpApprovals" targetRef="Task_ConsolidateOp" />
    <bpmn:sequenceFlow id="Flow_ConsOp_to_Send" sourceRef="Task_ConsolidateOp" targetRef="Task_SendOpToSCtrl" />
    <bpmn:sequenceFlow id="Flow_SendOpSCtrl_to_App" sourceRef="Task_SendOpToSCtrl" targetRef="Task_SCtrlApproveOp" />
    <bpmn:sequenceFlow id="Flow_SCtrlOp_to_Wait" sourceRef="Task_SCtrlApproveOp" targetRef="Task_WaitSCtrlOp" />
    <bpmn:sequenceFlow id="Flow_WaitSCtrlOp_to_Gw" sourceRef="Task_WaitSCtrlOp" targetRef="Gw_ErrorsOp" />
    <bpmn:sequenceFlow id="Flow_ErrOp_Yes" name="Yes" sourceRef="Gw_ErrorsOp" targetRef="Task_FixErrorsOp" />
    <bpmn:sequenceFlow id="Flow_ErrOp_No" name="No" sourceRef="Gw_ErrorsOp" targetRef="End_Op" />
    <bpmn:sequenceFlow id="Flow_FixOp_to_SendSCtrl" sourceRef="Task_FixErrorsOp" targetRef="Task_SendOpToSCtrl" />
    <bpmn:sequenceFlow id="Flow_TechJoin_to_Send" sourceRef="Gw_Join_TechInputs" targetRef="Task_SendTechToSup" />
    <bpmn:sequenceFlow id="Flow_SendTech_to_App" sourceRef="Task_SendTechToSup" targetRef="Task_SSupApproveTech" />
    <bpmn:sequenceFlow id="Flow_SSupTech_to_Wait" sourceRef="Task_SSupApproveTech" targetRef="Task_WaitSSupTech" />
    <bpmn:sequenceFlow id="Flow_Bnd3dSSupTech_Rem" sourceRef="Bnd_3d_SSupTech" targetRef="Task_RemindSSupTech" />
    <bpmn:sequenceFlow id="Flow_RemindSSupTech_End" sourceRef="Task_RemindSSupTech" targetRef="End_RemindSSupTech" />
    <bpmn:sequenceFlow id="Flow_WaitSSupTech_Cons" sourceRef="Task_WaitSSupTech" targetRef="Task_ConsolidateTech" />
    <bpmn:sequenceFlow id="Flow_ConsTech_to_Send" sourceRef="Task_ConsolidateTech" targetRef="Task_SendTechToSCtrl" />
    <bpmn:sequenceFlow id="Flow_SendTechSCtrl_App" sourceRef="Task_SendTechToSCtrl" targetRef="Task_SCtrlApproveTech" />
    <bpmn:sequenceFlow id="Flow_SCtrlTech_to_Wait" sourceRef="Task_SCtrlApproveTech" targetRef="Task_WaitSCtrlTech" />
    <bpmn:sequenceFlow id="Flow_WaitSCtrlTech_Gw" sourceRef="Task_WaitSCtrlTech" targetRef="Gw_ErrorsTech" />
    <bpmn:sequenceFlow id="Flow_ErrTech_Yes" name="Yes" sourceRef="Gw_ErrorsTech" targetRef="Task_FixErrorsTech" />
    <bpmn:sequenceFlow id="Flow_ErrTech_No" name="No" sourceRef="Gw_ErrorsTech" targetRef="End_Tech" />
    <bpmn:sequenceFlow id="Flow_FixTech_SendSCtrl" sourceRef="Task_FixErrorsTech" targetRef="Task_SendTechToSCtrl" />
    <bpmn:textAnnotation id="Note_PartnerRules">
      <bpmn:text>Partner sends «Ведомость о поощрении сотрудников» by the
25th of each month. Rules:
  • files for operators &amp; technicians are NOT separated —
    they arrive mixed in one email, separate emails, or a
    combined PDF;
  • one «Ведомость» per page; Partner name in page header;
  • operator vs technician is determined by the row's amount:
    operator if amount is a multiple of the global
    «minimal operator compensation» parameter; technician if
    a multiple of the «minimal technician compensation»;
  • email may include comment that operator approvals were
    already collected — those Operators are then skipped.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_PartnerRules" associationDirection="None" sourceRef="Note_PartnerRules" targetRef="Task_WaitVedomost" />
    <bpmn:textAnnotation id="Note_PreApproved">
      <bpmn:text>If the Partner's email noted that operator approvals
were already collected, those Operators are not contacted.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_PreApproved" associationDirection="None" sourceRef="Note_PreApproved" targetRef="Gw_OpsPreApproved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Compensation">
      <bpmndi:BPMNShape id="Lane_SCtrl_di" bpmnElement="Lane_SCtrl" isHorizontal="true">
        <dc:Bounds x="160" y="1500" width="3400" height="260" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SSup_di" bpmnElement="Lane_SSup" isHorizontal="true">
        <dc:Bounds x="160" y="1360" width="3400" height="140" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
