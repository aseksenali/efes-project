<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PromoMod" targetNamespace="http://camunda.org/examples" exporter="Camunda Modeler" exporterVersion="5.42.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_PromoMod" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PRT" name="Partner">
        <bpmn:flowNodeRef>Task_PRT_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PRT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SSC" name="Sales systems communication specialist">
        <bpmn:flowNodeRef>Gw_SSC_EmailMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SSC_AndJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SSC_Take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SSC_Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRM" name="CRM support specialist">
        <bpmn:flowNodeRef>Gw_CRM_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CRM_Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CRM_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OT" name="On-trade support specialist">
        <bpmn:flowNodeRef>Task_OT_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_OT_Split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TM" name="Trade marketing specialist">
        <bpmn:flowNodeRef>Task_TM_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TM_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Modification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SenderChoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Modification" name="Modification request initiated" />
    <bpmn:exclusiveGateway id="Gw_SenderChoice" name="Sender?" />
    <bpmn:task id="Task_TM_Send" name="Send modification file via Email" />
    <bpmn:parallelGateway id="Gw_TM_Split" />
    <bpmn:task id="Task_OT_Send" name="Send modification file via Email" />
    <bpmn:parallelGateway id="Gw_OT_Split" />
    <bpmn:exclusiveGateway id="Gw_CRM_Merge" />
    <bpmn:task id="Task_CRM_Change" name="Modify promo-activities&#10;in Panorama" />
    <bpmn:task id="Task_CRM_Notify" name="Notify SSC via Email" />
    <bpmn:exclusiveGateway id="Gw_SSC_EmailMerge" />
    <bpmn:parallelGateway id="Gw_SSC_AndJoin" />
    <bpmn:task id="Task_SSC_Take" name="Take changes from&#10;Internal system" />
    <bpmn:task id="Task_SSC_Send" name="Send changes to Partners&#10;via Email" />
    <bpmn:task id="Task_PRT_Receive" name="Receive promo-activities&#10;modifications" />
    <bpmn:endEvent id="End_PRT" name="Modifications applied" />
    <bpmn:sequenceFlow id="Flow_Start_Sender" sourceRef="Start_Modification" targetRef="Gw_SenderChoice" />
    <bpmn:sequenceFlow id="Flow_Sender_TM" name="Trade marketing" sourceRef="Gw_SenderChoice" targetRef="Task_TM_Send" />
    <bpmn:sequenceFlow id="Flow_Sender_OT" name="On-trade support" sourceRef="Gw_SenderChoice" targetRef="Task_OT_Send" />
    <bpmn:sequenceFlow id="Flow_SendTM_Split" sourceRef="Task_TM_Send" targetRef="Gw_TM_Split" />
    <bpmn:sequenceFlow id="Flow_SplitTM_CRM" sourceRef="Gw_TM_Split" targetRef="Gw_CRM_Merge" />
    <bpmn:sequenceFlow id="Flow_SplitTM_SSC" sourceRef="Gw_TM_Split" targetRef="Gw_SSC_EmailMerge" />
    <bpmn:sequenceFlow id="Flow_SendOT_Split" sourceRef="Task_OT_Send" targetRef="Gw_OT_Split" />
    <bpmn:sequenceFlow id="Flow_SplitOT_CRM" sourceRef="Gw_OT_Split" targetRef="Gw_CRM_Merge" />
    <bpmn:sequenceFlow id="Flow_SplitOT_SSC" sourceRef="Gw_OT_Split" targetRef="Gw_SSC_EmailMerge" />
    <bpmn:sequenceFlow id="Flow_CRMMerge_Change" sourceRef="Gw_CRM_Merge" targetRef="Task_CRM_Change" />
    <bpmn:sequenceFlow id="Flow_Change_Notify" sourceRef="Task_CRM_Change" targetRef="Task_CRM_Notify" />
    <bpmn:sequenceFlow id="Flow_Notify_Join" sourceRef="Task_CRM_Notify" targetRef="Gw_SSC_AndJoin" />
    <bpmn:sequenceFlow id="Flow_EmailMerge_Join" sourceRef="Gw_SSC_EmailMerge" targetRef="Gw_SSC_AndJoin" />
    <bpmn:sequenceFlow id="Flow_Join_Take" sourceRef="Gw_SSC_AndJoin" targetRef="Task_SSC_Take" />
    <bpmn:sequenceFlow id="Flow_Take_Send" sourceRef="Task_SSC_Take" targetRef="Task_SSC_Send" />
    <bpmn:sequenceFlow id="Flow_Send_Receive" sourceRef="Task_SSC_Send" targetRef="Task_PRT_Receive" />
    <bpmn:sequenceFlow id="Flow_Receive_End" sourceRef="Task_PRT_Receive" targetRef="End_PRT" />
    <bpmn:textAnnotation id="Note_SameContent">
      <bpmn:text>Same modification-file content regardless of sender — only the data format inside the file differs between Trade marketing and On-trade support.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_SameContent" sourceRef="Note_SameContent" targetRef="Gw_SenderChoice" />
    <bpmn:textAnnotation id="Note_InternalSystem">
      <bpmn:text>Internal system mirrors Panorama. SSC reads the applied changes here once CRM has finished.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_InternalSystem" sourceRef="Note_InternalSystem" targetRef="Task_SSC_Take" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_PromoMod">
      <bpmndi:BPMNShape id="Lane_PRT_di" bpmnElement="Lane_PRT" isHorizontal="true">
        <dc:Bounds x="160" y="730" width="1420" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SSC_di" bpmnElement="Lane_SSC" isHorizontal="true">
        <dc:Bounds x="160" y="540" width="1420" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CRM_di" bpmnElement="Lane_CRM" isHorizontal="true">
